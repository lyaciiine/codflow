---
import StoreLayout from "@/theme/layouts/StoreLayout.astro";
import OrderForm from "@/theme/components/order/OrderForm.astro";
import ShippingIsland from "@/theme/components/product/ShippingIsland.astro";
import { getStoreContext } from "@/theme/config/store";
import { fetchLandingPageBySlug } from "@/core/api/client";
import { actions } from "astro:actions";
import { isInputError } from "astro:actions";

const storeCtx = await getStoreContext();
const { config, content, isRTL } = storeCtx;

// استدعاء صفحة الهبوط بالـ Slug الصحيح (مثلاً: lacoste أو اسم صفحة الهبوط اللي راك دايرها في الداشبورد)
const lp = await fetchLandingPageBySlug("lacoste"); 
const product = lp?.product;

const cur = config.currencySymbol;
const defaultVariant = product?.hasVariants
  ? (product.variants.find((v: any) => v.isDefault) ?? product.variants[0])
  : null;
const basePrice = defaultVariant?.price ?? product?.price ?? 0;
const comparePrice = defaultVariant?.compareAtPrice ?? product?.compareAtPrice ?? null;
const isOutOfStock = product?.trackInventory && product.inventory === 0;
const defaultVariantId = defaultVariant?.id ?? null;

// معالجة إرسال الطلبية
const result = Astro.getActionResult(actions.placeOrder);
if (result?.data?.orderNumber) {
  return Astro.redirect(
    `/thank-you?order=${encodeURIComponent(result.data.orderNumber)}&total=${result.data.total}&oid=${encodeURIComponent(result.data.orderId ?? "")}`,
    303,
  );
}
const fieldErrors = isInputError(result?.error) ? result.error.fields : {};
const serverError = result?.error && !isInputError(result.error) ? result.error.message : null;

// ───────── إضافات خاصة بالديزاين فقط (ما تأثرش على اللوجيك) ─────────
// نجيبو صور المنتج بطريقة آمنة (تقبل نص مباشر ولا أوبجيكت فيه url/src)
const rawImages: any[] = (product as any)?.images ?? (lp as any)?.images ?? [];
const gallery: string[] = rawImages
  .map((img: any) => (typeof img === "string" ? img : (img?.url ?? img?.src ?? img?.image ?? null)))
  .filter(Boolean);
const heroImage = gallery[0] ?? null;
const storyImages = gallery.slice(1);

const hasDiscount = comparePrice && Number(comparePrice) > Number(basePrice);
const discountPct = hasDiscount
  ? Math.round(((Number(comparePrice) - Number(basePrice)) / Number(comparePrice)) * 100)
  : 0;

const features = [
  {
    title: "معدن راقي ضد الصدأ",
    text: "تصميم معدني راقي مقاوم للصدأ يحافظ على لمعانه مع مرور الوقت.",
    icon: "M12 3l2.4 5.2 5.6.6-4.2 3.8 1.2 5.6L12 15.4 7 18.2l1.2-5.6L4 8.8l5.6-.6L12 3z",
  },
  {
    title: "تفاصيل هندسية دقيقة",
    text: "تفاصيل هندسية دقيقة تعكس الفخامة والأناقة في كل زاوية.",
    icon: "M12 2l9 5v10l-9 5-9-5V7l9-5zm0 0v20M3 7l9 5 9-5",
  },
  {
    title: "قفل فريد بشعار التمساح",
    text: "قفل فريد يحمل شعار التمساح المميز اللي يعرّف الأصالة.",
    icon: "M7 11V8a5 5 0 0110 0v3M6 11h12a1 1 0 011 1v8a1 1 0 01-1 1H6a1 1 0 01-1-1v-8a1 1 0 011-1z",
  },
  {
    title: "علبة هدايا فاخرة",
    text: "يوصلك في علبة هدايا فاخرة مع كيس قماشي خاص بالعلامة، جاهز للإهداء.",
    icon: "M20 12v9H4v-9M2 7h20v5H2V7zm10 0v14M12 7S10 2 7.5 3.5 8 7 12 7zm0 0s2-5 4.5-3.5S16 7 12 7z",
  },
];

const trust = [
  { label: "الدفع عند الاستلام", icon: "M3 7h18v10H3V7zm9 2.5a2.5 2.5 0 100 5 2.5 2.5 0 000-5z" },
  { label: "توصيل لـ 58 ولاية", icon: "M3 7h11v9H3V7zm11 3h4l3 3v3h-7v-6zM7 19a1.5 1.5 0 100-3 1.5 1.5 0 000 3zm10 0a1.5 1.5 0 100-3 1.5 1.5 0 000 3z" },
  { label: "ضمان الجودة", icon: "M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6l8-3zm-3 9l2 2 4-4" },
];

const steps = [
  { n: "1", title: "عمر الفورمولار", text: "سجل اسمك، رقم هاتفك والولاية تاعك." },
  { n: "2", title: "نكلموك للتأكيد", text: "فريقنا يتصل بيك باش يأكد الطلبية." },
  { n: "3", title: "استلم وأدفع", text: "تستلم السوار لباب الدار وتدفع كاش." },
];
---

<StoreLayout config={config} content={content} title={lp?.metaTitle || "عرض خاص"} marketing={true}>
  {product && (
    <div class="bg-white min-h-screen pb-28 md:pb-16 overflow-x-hidden" dir={isRTL ? "rtl" : "ltr"}>
      
      <!-- جسر البيانات اللازم للسكريبتات والولايات -->
      <div
        id="page-data"
        class="sr-only"
        data-variants={JSON.stringify(product.variants ?? [])}
        data-base-price={basePrice}
        data-compare-price={comparePrice ?? ""}
        data-cur={cur}
        data-is-rtl={isRTL ? "1" : "0"}
        data-shipping-label={content.shippingLabel}
        data-shipping-calc={content.shippingCalculated}
        data-shipping-free={content.shippingFree}
        data-total-label={content.totalLabel}
        data-commune-placeholder={content.formCommunePlaceholder}
        data-commune-loading={content.formCommuneLoading}
        data-commune-disabled={content.formCommuneDisabled}
        data-offers={JSON.stringify(product.offers ?? [])}
        data-track-inventory={product.trackInventory ? "1" : "0"}
        data-out-of-stock-label={content.outOfStock}
        data-qty-max-stock={content.qtyMaxStock}
        data-inventory={String(product.inventory ?? 0)}
        data-pixel-id={lp.tracking?.pixelId ?? config.pixelId ?? ""}
        data-phone-invalid={content.formPhoneInvalid}
        data-product-id={product.id}
        data-product-name={product.name}
      />

      <ShippingIsland server:defer />

      <!-- ═════════ شريط الإعلان العلوي ═════════ -->
      <div class="bg-emerald-950 text-emerald-50 text-center text-xs sm:text-sm font-semibold py-2.5 px-4 tracking-wide">
        🚚 توصيل سريع لـ 58 ولاية &nbsp;•&nbsp; الدفع عند الاستلام
      </div>

      <!-- ═════════ الهيرو ═════════ -->
      <section class="relative bg-gradient-to-b from-gray-50 via-white to-white">
        <div class="max-w-2xl mx-auto px-5 pt-10 pb-8 text-center">
          <span class="reveal inline-flex items-center gap-2 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-100 px-4 py-1.5 text-xs font-bold mb-5">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75 animate-ping"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-600"></span>
            </span>
            عرض محدود • الكمية قليلة
          </span>

          <h1 class="reveal delay-1 text-[2rem] leading-[1.25] sm:text-5xl font-black text-gray-900 mb-3">
            أناقة تكمل إطلالتك
          </h1>
          <p class="reveal delay-2 text-base sm:text-xl text-gray-600 font-medium leading-relaxed mb-7">
            سوار لاكوست بتفاصيل هندسية مميزة
          </p>

          {heroImage && (
            <div class="reveal delay-3 relative mx-auto max-w-md">
              <div class="absolute -inset-4 bg-emerald-100/50 rounded-[2.5rem] blur-2xl"></div>
              <img
                src={heroImage}
                alt={product.name}
                width="800"
                height="800"
                loading="eager"
                fetchpriority="high"
                class="relative w-full rounded-3xl shadow-2xl shadow-emerald-900/10 ring-1 ring-black/5 object-cover"
              />
              {hasDiscount && (
                <div class="absolute top-3 start-3 bg-emerald-800 text-white text-sm font-black rounded-full px-3.5 py-1.5 shadow-lg">
                  -{discountPct}%
                </div>
              )}
            </div>
          )}

          <!-- السعر -->
          <div class="reveal delay-3 mt-7 flex items-end justify-center gap-3">
            <span class="text-4xl font-black text-emerald-900">{basePrice} <span class="text-xl">{cur}</span></span>
            {hasDiscount && (
              <span class="text-lg text-gray-400 line-through font-semibold mb-1">{comparePrice} {cur}</span>
            )}
          </div>

          <a
            href="#order-section-wrapper"
            class="reveal delay-4 mt-6 inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-2xl bg-emerald-800 hover:bg-emerald-900 active:scale-[0.98] text-white text-lg font-extrabold px-10 py-4 shadow-xl shadow-emerald-900/25 transition-all duration-300 cta-pulse"
          >
            اطلب الآن • الدفع عند الاستلام
            <svg class="w-5 h-5 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      </section>

      <!-- ═════════ شارات الثقة ═════════ -->
      <section class="max-w-2xl mx-auto px-4">
        <div class="reveal grid grid-cols-3 gap-2 sm:gap-4 rounded-2xl border border-gray-100 bg-gray-50/70 p-3 sm:p-5">
          {trust.map((t) => (
            <div class="flex flex-col items-center text-center gap-2">
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-white shadow-sm ring-1 ring-emerald-100 text-emerald-800">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={t.icon}/></svg>
              </span>
              <span class="text-[11px] sm:text-sm font-bold text-gray-800 leading-tight">{t.label}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- ═════════ المميزات ═════════ -->
      <section class="max-w-2xl mx-auto px-4 pt-14">
        <div class="reveal text-center mb-8">
          <p class="text-emerald-700 font-bold text-sm mb-2">علاش هذا السوار؟</p>
          <h2 class="text-2xl sm:text-4xl font-black text-gray-900">فخامة تبان من أول نظرة</h2>
        </div>

        <div class="grid gap-4">
          {features.map((f, i) => (
            <div class={`reveal flex items-start gap-4 rounded-2xl bg-white border border-gray-100 p-5 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 delay-${(i % 4) + 1}`}>
              <span class="shrink-0 flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-900 text-emerald-50">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={f.icon}/></svg>
              </span>
              <div>
                <h3 class="text-lg font-extrabold text-gray-900 mb-1">{f.title}</h3>
                <p class="text-gray-600 leading-relaxed text-[15px]">{f.text}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ═════════ قصة الصور (مرصوصة عمودياً) ═════════ -->
      {storyImages.length > 0 && (
        <section class="max-w-2xl mx-auto px-4 pt-14">
          <div class="reveal text-center mb-6">
            <h2 class="text-2xl sm:text-4xl font-black text-gray-900">شوف التفاصيل بعينيك</h2>
          </div>
          <div class="flex flex-col gap-5 sm:gap-7">
            {storyImages.map((src, i) => (
              <figure class="reveal overflow-hidden rounded-3xl bg-gray-100 ring-1 ring-black/5 shadow-md">
                <img
                  src={src}
                  alt={`${product.name} - ${i + 2}`}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-auto object-cover transition-transform duration-700 hover:scale-[1.03]"
                />
              </figure>
            ))}
          </div>
        </section>
      )}

      <!-- ═════════ كيفاش تطلب ═════════ -->
      <section class="max-w-2xl mx-auto px-4 pt-14">
        <div class="reveal rounded-3xl bg-emerald-950 text-white p-6 sm:p-10 relative overflow-hidden">
          <div class="absolute -top-16 -end-16 h-48 w-48 rounded-full bg-emerald-700/30 blur-3xl"></div>
          <h2 class="relative text-2xl sm:text-3xl font-black text-center mb-8">كيفاش تطلب؟ ٣ خطوات بسيطة</h2>
          <ol class="relative grid gap-5">
            {steps.map((s) => (
              <li class="flex items-start gap-4">
                <span class="shrink-0 flex h-10 w-10 items-center justify-center rounded-full bg-white text-emerald-900 font-black">{s.n}</span>
                <div>
                  <h3 class="font-extrabold text-lg">{s.title}</h3>
                  <p class="text-emerald-100/80 text-[15px] leading-relaxed">{s.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- ═════════ عنوان الفورمولار ═════════ -->
      <section class="max-w-xl mx-auto px-4 pt-14 pb-5 text-center">
        <h2 class="reveal text-2xl sm:text-4xl font-black text-gray-900 mb-2">اطلب سوارك دوك</h2>
        <p class="reveal delay-1 text-gray-600">عمر المعلومات تحت، وادفع كاش وقت يوصلك. بلا مخاطرة.</p>
      </section>

      <!-- 📦 فورمولار الدفع وحده صافي -->
      <div class="max-w-xl mx-auto px-4 scroll-mt-4" id="order-section-wrapper">
        <div class="reveal bg-white rounded-3xl shadow-2xl shadow-emerald-900/10 p-5 sm:p-7 border border-emerald-100 ring-1 ring-emerald-900/5">
          <OrderForm
            product={product}
            content={content}
            fieldErrors={fieldErrors}
            serverError={serverError}
            basePrice={basePrice}
            defaultVariant={defaultVariant ?? null}
            cur={cur}
            isRTL={isRTL}
            offers={product.offers}
            defaultVariantId={defaultVariantId}
            isOutOfStock={isOutOfStock}
            otpEnabled={config.otpEnabled === true}
            turnstileEnabled={config.turnstileEnabled === true}
            turnstileSiteKey={config.turnstileSiteKey ?? null}
            pages={config.pages ?? []}
            formPolicy={config.checkoutForm}
            landingPageSlug={lp.slug}
          />
        </div>

        <!-- ضمانات تحت الفورمولار -->
        <ul class="reveal mt-5 flex flex-wrap justify-center gap-x-5 gap-y-2 text-xs sm:text-sm font-semibold text-gray-600">
          <li>✅ دفع عند الاستلام</li>
          <li>✅ توصيل لـ 58 ولاية</li>
          <li>✅ ضمان الجودة</li>
        </ul>
      </div>

      <!-- ═════════ زر الطلب الثابت (موبايل فقط) ═════════ -->
      <div id="sticky-cta" class="md:hidden fixed inset-x-0 bottom-0 z-40 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] bg-white/90 backdrop-blur-md border-t border-gray-200 shadow-[0_-8px_24px_rgba(0,0,0,0.08)] transition-transform duration-300">
        <a
          href="#order-section-wrapper"
          class="flex items-center justify-between gap-3 rounded-2xl bg-emerald-800 active:bg-emerald-900 text-white px-5 py-3.5 shadow-lg shadow-emerald-900/30"
        >
          <span class="text-base font-extrabold">اطلب الآن • الدفع عند الاستلام</span>
          <span class="text-base font-black whitespace-nowrap">{basePrice} {cur}</span>
        </a>
      </div>

    </div>
  )}

  {!product && (
    <div class="flex flex-col items-center justify-center py-24 px-6 text-center">
      <h1 class="text-2xl font-black text-red-600">عذراً، لم يتم العثور على صفحة الهبوط أو أن الslug خاطئ.</h1>
    </div>
  )}
</StoreLayout>

<style>
  /* أنيميشن الظهور عند السكرول */
  .reveal {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }
  .reveal.is-visible {
    opacity: 1;
    transform: none;
  }
  .delay-1 { transition-delay: 0.08s; }
  .delay-2 { transition-delay: 0.16s; }
  .delay-3 { transition-delay: 0.24s; }
  .delay-4 { transition-delay: 0.32s; }

  /* نبضة خفيفة على زر الطلب الرئيسي */
  .cta-pulse {
    animation: ctaGlow 2.6s ease-in-out infinite;
  }
  @keyframes ctaGlow {
    0%, 100% { box-shadow: 0 12px 28px -8px rgba(6, 78, 59, 0.35); }
    50% { box-shadow: 0 12px 36px -4px rgba(6, 78, 59, 0.6); }
  }

  /* الزر الثابت يتخبى كي يوصل الزبون للفورمولار */
  #sticky-cta.is-hidden {
    transform: translateY(110%);
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
    .cta-pulse { animation: none; }
    html { scroll-behavior: auto; }
  }
</style>

<!-- السكريبتات الأساسية -->
<script src="../theme/scripts/product.ts"></script>
<script src="../theme/scripts/otp-step.ts"></script>
<script src="../theme/scripts/turnstile-field.ts"></script>
<script src="../theme/scripts/track-abandonment.ts"></script>

<!-- سكريبت الديزاين: أنيميشن السكرول + إخفاء الزر الثابت (ما يتدخلش في لوجيك الطلب) -->
<script>
  const revealEls = document.querySelectorAll<HTMLElement>(".reveal");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("is-visible");
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
    );
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add("is-visible"));
  }

  const sticky = document.getElementById("sticky-cta");
  const orderWrap = document.getElementById("order-section-wrapper");
  if (sticky && orderWrap && "IntersectionObserver" in window) {
    new IntersectionObserver(
      ([entry]) => {
        sticky.classList.toggle("is-hidden", entry.isIntersecting);
      },
      { threshold: 0.15 },
    ).observe(orderWrap);
  }
</script>
