---
import StoreLayout from "@/theme/layouts/StoreLayout.astro";
import OrderForm from "@/theme/components/order/OrderForm.astro";
import ShippingIsland from "@/theme/components/product/ShippingIsland.astro";
import { getStoreContext } from "@/theme/config/store";
import { fetchLandingPageBySlug } from "@/core/api/client";
import { actions } from "astro:actions";
import { isInputError } from "astro:actions";

const storeCtx = await getStoreContext();
const { config, content, isRTL } = storeCtx;

// استدعاء صفحة الهبوط بالـ Slug الصحيح (مثلاً: lacoste أو اسم صفحة الهبوط اللي راك دايرها في الداشبورد)
const lp = await fetchLandingPageBySlug("lacoste"); 
const product = lp?.product;

const cur = config.currencySymbol;
const defaultVariant = product?.hasVariants
  ? (product.variants.find((v: any) => v.isDefault) ?? product.variants[0])
  : null;
const basePrice = defaultVariant?.price ?? product?.price ?? 0;
const comparePrice = defaultVariant?.compareAtPrice ?? product?.compareAtPrice ?? null;
const isOutOfStock = product?.trackInventory && product.inventory === 0;
const defaultVariantId = defaultVariant?.id ?? null;

// معالجة إرسال الطلبية
const result = Astro.getActionResult(actions.placeOrder);
if (result?.data?.orderNumber) {
  return Astro.redirect(
    `/thank-you?order=${encodeURIComponent(result.data.orderNumber)}&total=${result.data.total}&oid=${encodeURIComponent(result.data.orderId ?? "")}`,
    303,
  );
}
const fieldErrors = isInputError(result?.error) ? result.error.fields : {};
const serverError = result?.error && !isInputError(result.error) ? result.error.message : null;
---

<StoreLayout config={config} content={content} title={lp?.metaTitle || "عرض خاص"} marketing={true}>
  {product && (
    <div class="min-h-screen bg-white pb-28 text-slate-900 md:pb-12" dir={isRTL ? "rtl" : "ltr"}>
      <!-- جسر البيانات اللازم للسكريبتات والولايات -->
      <div
        id="page-data"
        class="sr-only"
        data-variants={JSON.stringify(product.variants ?? [])}
        data-base-price={basePrice}
        data-compare-price={comparePrice ?? ""}
        data-cur={cur}
        data-is-rtl={isRTL ? "1" : "0"}
        data-shipping-label={content.shippingLabel}
        data-shipping-calc={content.shippingCalculated}
        data-shipping-free={content.shippingFree}
        data-total-label={content.totalLabel}
        data-commune-placeholder={content.formCommunePlaceholder}
        data-commune-loading={content.formCommuneLoading}
        data-commune-disabled={content.formCommuneDisabled}
        data-offers={JSON.stringify(product.offers ?? [])}
        data-track-inventory={product.trackInventory ? "1" : "0"}
        data-out-of-stock-label={content.outOfStock}
        data-qty-max-stock={content.qtyMaxStock}
        data-inventory={String(product.inventory ?? 0)}
        data-pixel-id={lp.tracking?.pixelId ?? config.pixelId ?? ""}
        data-phone-invalid={content.formPhoneInvalid}
        data-product-id={product.id}
        data-product-name={product.name}
      />

      <ShippingIsland server:defer />

      <!-- واجهة العرض -->
      <header class="border-b border-slate-100 bg-white">
        <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
          <a href="#top" class="flex min-w-0 items-center gap-2.5" aria-label="العودة لبداية الصفحة">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-emerald-950 text-white shadow-sm">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path d="M7 8.5 12 5l5 3.5v7L12 19l-5-3.5z" />
                <path d="m7.5 8.8 4.5 3.1 4.5-3.1M12 12v6.5" />
              </svg>
            </span>
            <span class="min-w-0">
              <span class="block truncate text-sm font-black tracking-wide text-slate-900">أناقة لا تفوتك</span>
              <span class="mt-0.5 block text-[11px] text-slate-500">اختيارك اليومي للتفاصيل الراقية</span>
            </span>
          </a>
          <a href="#order-section-wrapper" class="inline-flex shrink-0 items-center justify-center rounded-full border border-emerald-900/15 px-4 py-2 text-xs font-bold text-emerald-950 transition hover:border-emerald-900 hover:bg-emerald-950 hover:text-white focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:ring-offset-2">
            اطلب الآن
          </a>
        </div>
      </header>

      <main id="top">
        <!-- المقدمة والعرض -->
        <section class="relative overflow-hidden bg-gradient-to-b from-emerald-50/70 via-white to-white">
          <div class="pointer-events-none absolute -left-24 top-10 h-64 w-64 rounded-full bg-emerald-100/60 blur-3xl" aria-hidden="true"></div>
          <div class="pointer-events-none absolute -right-24 top-44 h-64 w-64 rounded-full bg-stone-100 blur-3xl" aria-hidden="true"></div>

          <div class="relative mx-auto grid max-w-6xl gap-8 px-4 pb-10 pt-8 sm:px-6 sm:pb-14 sm:pt-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-14 lg:py-16">
            <div class="lp-reveal order-1 text-center lg:text-right">
              <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-emerald-900/10 bg-white/85 px-3.5 py-2 text-xs font-bold text-emerald-950 shadow-sm backdrop-blur">
                <span class="h-2 w-2 rounded-full bg-emerald-600"></span>
                تفاصيل صغيرة… فرق كبير
              </div>
              <h1 class="mx-auto max-w-2xl text-3xl font-black leading-[1.35] tracking-tight text-slate-950 sm:text-4xl lg:mx-0 lg:text-5xl lg:leading-[1.3]">
                أناقة تكمل إطلالتك
                <span class="mt-1 block text-emerald-800">سوار لاكوست بتفاصيل هندسية مميزة</span>
              </h1>
              <p class="mx-auto mt-5 max-w-xl text-sm leading-7 text-slate-600 sm:text-base sm:leading-8 lg:mx-0">
                لمسة راقية تزيد إطلالتك تميّز، بتصميم معدني أنيق وتفاصيل مدروسة، يجيك في علبة هدايا فاخرة.
              </p>

              <div class="mt-6 flex flex-wrap justify-center gap-2 lg:justify-start">
                <span class="inline-flex items-center gap-2 rounded-full bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 ring-1 ring-slate-200">
                  <svg viewBox="0 0 24 24" class="h-4 w-4 text-emerald-800" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3 19 6v5c0 4.4-2.8 7.9-7 10-4.2-2.1-7-5.6-7-10V6z"/><path d="m9 12 2 2 4-4"/></svg>
                  جودة مختارة بعناية
                </span>
                <span class="inline-flex items-center gap-2 rounded-full bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 ring-1 ring-slate-200">
                  <svg viewBox="0 0 24 24" class="h-4 w-4 text-emerald-800" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="6" width="13" height="11" rx="1.5"/><path d="M16 10h3l2 3v4h-5z"/><circle cx="7.5" cy="18" r="1.8"/><circle cx="18" cy="18" r="1.8"/></svg>
                  توصيل لـ ٥٨ ولاية
                </span>
                <span class="inline-flex items-center gap-2 rounded-full bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 ring-1 ring-slate-200">
                  <svg viewBox="0 0 24 24" class="h-4 w-4 text-emerald-800" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><path d="m9 15 2 2 4-4"/></svg>
                  الدفع عند الاستلام
                </span>
              </div>

              <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row lg:justify-start">
                <a href="#order-section-wrapper" class="group inline-flex w-full items-center justify-center gap-3 rounded-2xl bg-emerald-950 px-7 py-4 text-sm font-extrabold text-white shadow-lg shadow-emerald-950/15 transition duration-300 hover:-translate-y-0.5 hover:bg-emerald-900 hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:ring-offset-2 sm:w-auto">
                  <span>{isOutOfStock ? "شوف تفاصيل المنتج" : "اطلب سوارك الآن"}</span>
                  <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5m7 7-7-7 7-7"/></svg>
                </a>
                <div class="text-center lg:text-right">
                  <div class="flex items-center justify-center gap-2 lg:justify-start">
                    <span class="text-2xl font-black tracking-tight text-slate-950">{basePrice} <span class="text-sm font-bold">{cur}</span></span>
                    {comparePrice && comparePrice > basePrice && <span class="text-sm font-medium text-slate-400 line-through">{comparePrice} {cur}</span>}
                  </div>
                  <p class="mt-1 text-xs text-slate-500">تأكد من معلوماتك قبل تأكيد الطلب</p>
                </div>
              </div>
              <div class="mt-6 flex items-center justify-center gap-2 text-xs text-slate-500 lg:justify-start">
                <span class="flex -space-x-1.5" aria-hidden="true">
                  <span class="h-6 w-6 rounded-full border-2 border-white bg-emerald-100"></span>
                  <span class="h-6 w-6 rounded-full border-2 border-white bg-stone-200"></span>
                  <span class="h-6 w-6 rounded-full border-2 border-white bg-emerald-800"></span>
                </span>
                <span>طلب ساهل، وتخلّص كي توصلك الطلبية</span>
              </div>
            </div>

            <!-- صور المنتج: تُعرض الصور الموجودة في بيانات المنتج، بلا صور تجريبية أو مصطنعة -->
            <div class="lp-reveal lp-delay-1 order-2 mx-auto w-full max-w-xl lg:max-w-none">
              <div class="mb-3 flex items-center justify-between px-1">
                <span class="text-xs font-bold tracking-wide text-emerald-950">تفاصيل السوار</span>
                <span class="text-[11px] text-slate-400">تصميم أنيق لكل يوم</span>
              </div>
              <div class="grid grid-cols-1 gap-4">
                {(Array.isArray((product as any).images)
                  ? (product as any).images
                  : Array.isArray((product as any).gallery)
                    ? (product as any).gallery
                    : Array.isArray((product as any).media)
                      ? (product as any).media
                      : []
                ).map((image: any, index: number) => {
                  const imageUrl = typeof image === "string" ? image : image?.url ?? image?.src ?? image?.imageUrl ?? image?.secure_url;
                  return imageUrl ? (
                    <figure class="lp-image-card group relative overflow-hidden rounded-[1.75rem] border border-slate-100 bg-stone-50 shadow-sm">
                      <img
                        src={imageUrl}
                        alt={`صورة سوار لاكوست رقم ${index + 1}`}
                        loading={index === 0 ? "eager" : "lazy"}
                        fetchpriority={index === 0 ? "high" : "auto"}
                        class="aspect-[4/3] w-full object-cover transition duration-700 group-hover:scale-[1.025] sm:aspect-[5/3] lg:aspect-[5/3]"
                      />
                      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-black/20 to-transparent"></div>
                      <figcaption class="absolute bottom-4 right-4 rounded-full border border-white/50 bg-white/85 px-3 py-1.5 text-[11px] font-bold text-slate-800 shadow-sm backdrop-blur">{index === 0 ? "التصميم عن قرب" : "تفاصيل إضافية"}</figcaption>
                    </figure>
                  ) : null;
                })}
                {(!((Array.isArray((product as any).images) ? (product as any).images : Array.isArray((product as any).gallery) ? (product as any).gallery : Array.isArray((product as any).media) ? (product as any).media : []).length)
                  && ((product as any).imageUrl ?? (product as any).image ?? (product as any).featuredImage ?? (product as any).thumbnail)) && (
                  <figure class="lp-image-card group relative overflow-hidden rounded-[1.75rem] border border-slate-100 bg-stone-50 shadow-sm">
                    <img
                      src={((product as any).imageUrl ?? (product as any).image ?? (product as any).featuredImage ?? (product as any).thumbnail)?.url ?? ((product as any).imageUrl ?? (product as any).image ?? (product as any).featuredImage ?? (product as any).thumbnail)?.src ?? ((product as any).imageUrl ?? (product as any).image ?? (product as any).featuredImage ?? (product as any).thumbnail)}
                      alt="سوار لاكوست بتفاصيل هندسية مميزة"
                      loading="eager"
                      fetchpriority="high"
                      class="aspect-[4/3] w-full object-cover transition duration-700 group-hover:scale-[1.025] sm:aspect-[5/3] lg:aspect-[5/3]"
                    />
                    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-black/20 to-transparent"></div>
                    <figcaption class="absolute bottom-4 right-4 rounded-full border border-white/50 bg-white/85 px-3 py-1.5 text-[11px] font-bold text-slate-800 shadow-sm backdrop-blur">التصميم عن قرب</figcaption>
                  </figure>
                )}
                {(!((Array.isArray((product as any).images) ? (product as any).images : Array.isArray((product as any).gallery) ? (product as any).gallery : Array.isArray((product as any).media) ? (product as any).media : []).length)
                  && !((product as any).imageUrl ?? (product as any).image ?? (product as any).featuredImage ?? (product as any).thumbnail)) && (
                  <div class="flex aspect-[4/3] flex-col items-center justify-center rounded-[1.75rem] border border-dashed border-emerald-900/20 bg-gradient-to-br from-emerald-50 to-stone-100 px-6 text-center sm:aspect-[5/3]">
                    <span class="mb-4 flex h-16 w-16 items-center justify-center rounded-3xl bg-white text-emerald-900 shadow-sm" aria-hidden="true">
                      <svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 8.5 12 5l5 3.5v7L12 19l-5-3.5z"/><path d="m7.5 8.8 4.5 3.1 4.5-3.1M12 12v6.5"/></svg>
                    </span>
                    <p class="text-sm font-extrabold text-slate-800">سوار لاكوست</p>
                    <p class="mt-2 max-w-xs text-xs leading-6 text-slate-500">صور المنتج ما راهيش متوفرة في بيانات الصفحة الحالية.</p>
                  </div>
                )}
              </div>
            </div>
          </div>
        </section>

        <!-- نقاط القوة -->
        <section class="border-y border-slate-100 bg-stone-50/70">
          <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
            <div class="mx-auto mb-7 max-w-2xl text-center sm:mb-9">
              <p class="text-xs font-extrabold tracking-widest text-emerald-800">تفاصيل تستاهلها</p>
              <h2 class="mt-2 text-2xl font-black leading-tight text-slate-950 sm:text-3xl">أناقة باينة في كل تفصيل</h2>
              <p class="mt-3 text-sm leading-7 text-slate-600">من اللمسة المعدنية حتى طريقة التقديم، كل حاجة تزيد تكمل قيمة الهدية وإطلالتك.</p>
            </div>

            <div class="grid gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-4">
              <article class="lp-reveal rounded-2xl border border-slate-100 bg-white p-5 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-md">
                <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-900">
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 3 19 6v5c0 4.4-2.8 7.9-7 10-4.2-2.1-7-5.6-7-10V6z"/><path d="m9 12 2 2 4-4"/></svg>
                </span>
                <h3 class="text-sm font-extrabold text-slate-900">معدن راقي</h3>
                <p class="mt-2 text-xs leading-6 text-slate-600">تصميم معدني مقاوم للصدأ يساعد السوار يحافظ على لمعانه.</p>
              </article>
              <article class="lp-reveal lp-delay-1 rounded-2xl border border-slate-100 bg-white p-5 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-md">
                <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-900">
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9z"/><path d="m4 7.5 8 4.7 8-4.7M12 12.2V21"/></svg>
                </span>
                <h3 class="text-sm font-extrabold text-slate-900">تفاصيل هندسية</h3>
                <p class="mt-2 text-xs leading-6 text-slate-600">خطوط دقيقة ولمسة عصرية تعطي لإطلالتك حضور مميز.</p>
              </article>
              <article class="lp-reveal lp-delay-2 rounded-2xl border border-slate-100 bg-white p-5 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-md">
                <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-900">
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="5" y="7" width="14" height="10" rx="2"/><path d="M9 7V5h6v2M9 12h6M12 10v4"/></svg>
                </span>
                <h3 class="text-sm font-extrabold text-slate-900">قفل مميز</h3>
                <p class="mt-2 text-xs leading-6 text-slate-600">قفل مميز يحمل شعار التمساح المعروف.</p>
              </article>
              <article class="lp-reveal lp-delay-3 rounded-2xl border border-slate-100 bg-white p-5 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-md">
                <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-900">
                  <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 9 12 4l8 5v10H4z"/><path d="M9 19v-6h6v6M4 9h16"/></svg>
                </span>
                <h3 class="text-sm font-extrabold text-slate-900">علبة هدايا فاخرة</h3>
                <p class="mt-2 text-xs leading-6 text-slate-600">يجيك في علبة أنيقة مع كيس قماشي خاص بالعلامة.</p>
              </article>
            </div>
          </div>
        </section>

        <!-- طريقة الطلب والثقة -->
        <section class="bg-white">
          <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
            <div class="grid gap-6 lg:grid-cols-[1fr_1.2fr] lg:items-center lg:gap-12">
              <div class="lp-reveal">
                <p class="text-xs font-extrabold tracking-widest text-emerald-800">بكل سهولة</p>
                <h2 class="mt-2 text-2xl font-black leading-tight text-slate-950 sm:text-3xl">اطلبه في خطوات بسيطة</h2>
                <p class="mt-3 text-sm leading-7 text-slate-600">عمّر معلوماتك، اختار الولاية والبلدية، وتأكد من الطلبية قبل الإرسال.</p>
                <a href="#order-section-wrapper" class="mt-5 inline-flex items-center gap-2 text-sm font-extrabold text-emerald-900 transition hover:text-emerald-700">
                  روح لاستمارة الطلب
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5m7 7-7-7 7-7"/></svg>
                </a>
              </div>

              <div class="grid gap-3 sm:grid-cols-3">
                <div class="flex items-start gap-3 rounded-2xl border border-slate-100 bg-slate-50/70 p-4">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-sm font-black text-emerald-900 shadow-sm">١</span>
                  <div><h3 class="text-sm font-extrabold text-slate-900">عمّر معلوماتك</h3><p class="mt-1 text-xs leading-5 text-slate-500">الاسم ورقم الهاتف والعنوان.</p></div>
                </div>
                <div class="flex items-start gap-3 rounded-2xl border border-slate-100 bg-slate-50/70 p-4">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-sm font-black text-emerald-900 shadow-sm">٢</span>
                  <div><h3 class="text-sm font-extrabold text-slate-900">أكد الطلبية</h3><p class="mt-1 text-xs leading-5 text-slate-500">راجع التفاصيل قبل الإرسال.</p></div>
                </div>
                <div class="flex items-start gap-3 rounded-2xl border border-slate-100 bg-slate-50/70 p-4">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white text-sm font-black text-emerald-900 shadow-sm">٣</span>
                  <div><h3 class="text-sm font-extrabold text-slate-900">خلّص عند الاستلام</h3><p class="mt-1 text-xs leading-5 text-slate-500">الدفع كي توصلك الطلبية.</p></div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- استمارة الطلب: خصائص الفورمولار ومنطق الإرسال محفوظين -->
        <section class="bg-gradient-to-b from-stone-50 to-emerald-50/50 px-4 py-10 sm:px-6 sm:py-14" aria-labelledby="order-title">
          <div class="mx-auto max-w-xl" id="order-section-wrapper">
            <div class="mb-5 text-center">
              <span class="inline-flex items-center gap-2 rounded-full bg-emerald-100 px-3 py-1.5 text-[11px] font-extrabold text-emerald-950">
                <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12.5 9.5 17 19 7"/></svg>
                الدفع عند الاستلام
              </span>
              <h2 id="order-title" class="mt-3 text-2xl font-black text-slate-950 sm:text-3xl">كمّل طلبك من هنا</h2>
              <p class="mt-2 text-sm leading-6 text-slate-600">دخل معلومات صحيحة باش نوصلولك الطلبية بلا تعقيدات.</p>
            </div>

            <div class="rounded-[1.75rem] border border-slate-100 bg-white p-4 shadow-[0_18px_60px_-24px_rgba(15,23,42,0.22)] sm:p-6">
              <OrderForm
                product={product}
                content={content}
                fieldErrors={fieldErrors}
                serverError={serverError}
                basePrice={basePrice}
                defaultVariant={defaultVariant ?? null}
                cur={cur}
                isRTL={isRTL}
                offers={product.offers}
                defaultVariantId={defaultVariantId}
                isOutOfStock={isOutOfStock}
                otpEnabled={config.otpEnabled === true}
                turnstileEnabled={config.turnstileEnabled === true}
                turnstileSiteKey={config.turnstileSiteKey ?? null}
                pages={config.pages ?? []}
                formPolicy={config.checkoutForm}
                landingPageSlug={lp.slug}
              />
            </div>

            <div class="mt-4 grid grid-cols-3 gap-2 text-center">
              <div class="rounded-xl border border-slate-100 bg-white/80 px-2 py-3">
                <svg viewBox="0 0 24 24" class="mx-auto mb-1.5 h-5 w-5 text-emerald-800" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                <span class="block text-[10px] font-bold text-slate-600 sm:text-xs">الدفع عند الاستلام</span>
              </div>
              <div class="rounded-xl border border-slate-100 bg-white/80 px-2 py-3">
                <svg viewBox="0 0 24 24" class="mx-auto mb-1.5 h-5 w-5 text-emerald-800" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"/><circle cx="7" cy="18" r="1.5"/><circle cx="18" cy="18" r="1.5"/></svg>
                <span class="block text-[10px] font-bold text-slate-600 sm:text-xs">توصيل سريع لـ ٥٨ ولاية</span>
              </div>
              <div class="rounded-xl border border-slate-100 bg-white/80 px-2 py-3">
                <svg viewBox="0 0 24 24" class="mx-auto mb-1.5 h-5 w-5 text-emerald-800" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 3 19 6v5c0 4.4-2.8 7.9-7 10-4.2-2.1-7-5.6-7-10V6z"/><path d="m9 12 2 2 4-4"/></svg>
                <span class="block text-[10px] font-bold text-slate-600 sm:text-xs">عناية في كل تفصيل</span>
              </div>
            </div>
          </div>
        </section>
      </main>

      <footer class="border-t border-slate-100 bg-white px-4 py-6 text-center">
        <p class="text-xs leading-6 text-slate-500">شكراً على ثقتك — أناقة تكمل إطلالتك</p>
      </footer>

      <!-- زر ثابت للهاتف يوجّه مباشرة لاستمارة الطلب -->
      <div class="mobile-sticky-cta fixed inset-x-0 bottom-0 z-50 border-t border-slate-200/80 bg-white/95 px-4 pt-3 shadow-[0_-10px_35px_-18px_rgba(15,23,42,0.3)] backdrop-blur-xl md:hidden">
        <div class="mx-auto flex max-w-xl items-center gap-3">
          <div class="min-w-0 flex-1">
            <p class="text-[10px] font-semibold text-slate-500">السعر</p>
            <p class="truncate text-base font-black text-slate-950">{basePrice} <span class="text-xs">{cur}</span></p>
          </div>
          <a href="#order-section-wrapper" class="inline-flex min-h-12 flex-[2] items-center justify-center gap-2 rounded-xl bg-emerald-950 px-4 text-sm font-extrabold text-white shadow-lg shadow-emerald-950/20 transition active:scale-[0.98] hover:bg-emerald-900 focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:ring-offset-2">
            {isOutOfStock ? "شوف تفاصيل المنتج" : "اطلب سوارك الآن"}
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5m7 7-7-7 7-7"/></svg>
          </a>
        </div>
      </div>
    </div>
  )}

  {!product && (
    <div class="flex min-h-[60vh] flex-col items-center justify-center px-6 py-24 text-center">
      <span class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-red-50 text-red-600" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5m0 4h.01"/></svg>
      </span>
      <h1 class="text-2xl font-black text-slate-900">سمح لينا، ما لقيناش صفحة المنتج</h1>
      <p class="mt-3 max-w-md text-sm leading-7 text-slate-500">تأكد من رابط صفحة العرض أو راجع إعدادات المنتج، ومن بعد عاود جرّب.</p>
    </div>
  )}
</StoreLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 1rem;
  }

  #order-section-wrapper {
    scroll-margin-top: 1rem;
  }

  .lp-reveal {
    animation: lp-rise-in 680ms cubic-bezier(0.2, 0.75, 0.25, 1) both;
  }

  .lp-delay-1 { animation-delay: 100ms; }
  .lp-delay-2 { animation-delay: 180ms; }
  .lp-delay-3 { animation-delay: 260ms; }

  .lp-image-card {
    isolation: isolate;
  }

  .mobile-sticky-cta {
    padding-bottom: calc(0.75rem + env(safe-area-inset-bottom));
  }

  @keyframes lp-rise-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    .lp-reveal { animation: none; }
    .lp-image-card img,
    .lp-image-card,
    a { transition: none !important; }
  }
</style>

