<!-- الأنيميشن وسلوك CTA الثابت -->
<script>
  const initializeLandingPage = () => {
    const root = document.querySelector(".premium-landing");
    if (!root) return;

    const stickyCta = root.querySelector(".mobile-sticky-cta");
    const orderWrapper = root.querySelector("#order-section-wrapper");
    const revealElements = root.querySelectorAll(".landing-reveal");

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    // إظهار الأقسام تدريجياً عند الوصول إليها.
    if (
      !reducedMotion &&
      "IntersectionObserver" in window &&
      revealElements.length
    ) {
      document.documentElement.classList.add("js-reveal-ready");

      const revealObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        },
        {
          root: null,
          threshold: 0.08,
          rootMargin: "0px 0px -24px 0px",
        },
      );

      revealElements.forEach((element) => {
        revealObserver.observe(element);
      });
    } else {
      revealElements.forEach((element) => {
        element.classList.add("is-visible");
      });
    }

    if (!stickyCta || !orderWrapper) return;

    // إخفاء الزر كي يظهر الفورمولار.
    if ("IntersectionObserver" in window) {
      const orderObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            stickyCta.classList.toggle(
              "is-hidden",
              entry.isIntersecting,
            );
          });
        },
        {
          root: null,
          threshold: 0,
          rootMargin: "0px",
        },
      );

      orderObserver.observe(orderWrapper);
    }

    // تحديث الحالة عند تبديل حجم الشاشة.
    const mobileQuery = window.matchMedia("(max-width: 767px)");

    const updateStickyVisibility = () => {
      if (!mobileQuery.matches) {
        stickyCta.classList.remove("is-hidden");
      }
    };

    updateStickyVisibility();
    mobileQuery.addEventListener?.("change", updateStickyVisibility);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeLandingPage, {
      once: true,
    });
  } else {
    initializeLandingPage();
  }
</script>

