---
import StoreLayout from "@/theme/layouts/StoreLayout.astro";
import OrderForm from "@/theme/components/order/OrderForm.astro";
import ShippingIsland from "@/theme/components/product/ShippingIsland.astro";
import { getStoreContext } from "@/theme/config/store";
import { fetchLandingPageBySlug } from "@/core/api/client";
import { actions } from "astro:actions";
import { isInputError } from "astro:actions";

const storeCtx = await getStoreContext();
const { config, content, isRTL } = storeCtx;

// استدعاء صفحة الهبوط بالـ Slug الصحيح[span_1](start_span)[span_1](end_span)
const lp = await fetchLandingPageBySlug("lacoste"); 
const product = lp?.product;

const cur = config.currencySymbol;
const defaultVariant = product?.hasVariants
  ? (product.variants.find((v: any) => v.isDefault) ?? product.variants[0])
  : null;
const basePrice = defaultVariant?.price ?? product?.price ?? 0;
const comparePrice = defaultVariant?.compareAtPrice ?? product?.compareAtPrice ?? null;
const isOutOfStock = product?.trackInventory && product.inventory === 0;
const defaultVariantId = defaultVariant?.id ?? null;

// استخراج صور المنتج من الـ API (مع إضافة Fallback في حال عدم وجود صور)
const images = product?.images || [];
const getImgUrl = (index: number) => {
  if (!images[index]) return null;
  return typeof images[index] === 'object' ? images[index].url : images[index];
};

const heroImg = getImgUrl(0) || "https://placehold.co/800x1200/0f172a/ffffff?text=صورة+المنتج+الرئيسية";
const featImg1 = getImgUrl(1) || "https://placehold.co/600x600/f8fafc/0f172a?text=تفاصيل+عن+قرب";
const featImg2 = getImgUrl(2) || "https://placehold.co/600x600/f8fafc/0f172a?text=العلبة+الفاخرة";

// معالجة إرسال الطلبية[span_2](start_span)[span_2](end_span)
const result = Astro.getActionResult(actions.placeOrder);
if (result?.data?.orderNumber) {
  return Astro.redirect(
    `/thank-you?order=${encodeURIComponent(result.data.orderNumber)}&total=${result.data.total}&oid=${encodeURIComponent(result.data.orderId ?? "")}`,
    303,
  );
}
const fieldErrors = isInputError(result?.error) ? result.error.fields : {};
const serverError = result?.error && !isInputError(result.error) ? result.error.message : null;
---

<StoreLayout config={config} content={content} title={lp?.metaTitle || product?.name || "عرض خاص"} marketing={true}>
  
  <style>
    /* أنيميشن الدخول والظهور السلس */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
      animation: fadeInUp 0.8s ease-out forwards;
      opacity: 0;
    }
    .delay-100 { animation-delay: 100ms; }
    .delay-200 { animation-delay: 200ms; }
    .delay-300 { animation-delay: 300ms; }
    
    /* أنيميشن شريط الإعلانات المتحرك */
    @keyframes marquee {
      0% { transform: translateX(0%); }
      100% { transform: translateX(100%); }
    }
    .animate-marquee {
      display: inline-block;
      white-space: nowrap;
      animation: marquee 20s linear infinite;
    }
    
    html { scroll-behavior: smooth; }
  </style>

  {product && (
    <div class="bg-slate-50 min-h-screen font-sans selection:bg-emerald-200" dir="rtl">
      
      <!-- جسر البيانات اللازم للسكريبتات والولايات (DO NOT TOUCH)[span_3](start_span)[span_3](end_span) -->
      <div
        id="page-data"
        class="sr-only"
        data-variants={JSON.stringify(product.variants ?? [])}
        data-base-price={basePrice}
        data-compare-price={comparePrice ?? ""}
        data-cur={cur}
        data-is-rtl={isRTL ? "1" : "0"}
        data-shipping-label={content.shippingLabel}
        data-shipping-calc={content.shippingCalculated}
        data-shipping-free={content.shippingFree}
        data-total-label={content.totalLabel}
        data-commune-placeholder={content.formCommunePlaceholder}
        data-commune-loading={content.formCommuneLoading}
        data-commune-disabled={content.formCommuneDisabled}
        data-offers={JSON.stringify(product.offers ?? [])}
        data-track-inventory={product.trackInventory ? "1" : "0"}
        data-out-of-stock-label={content.outOfStock}
        data-qty-max-stock={content.qtyMaxStock}
        data-inventory={String(product.inventory ?? 0)}
        data-pixel-id={lp.tracking?.pixelId ?? config.pixelId ?? ""}
        data-phone-invalid={content.formPhoneInvalid}
        data-product-id={product.id}
        data-product-name={product.name}
      />

      <!-- شريط إعلانات علوي (Top Bar) -->
      <div class="bg-emerald-600 text-white text-xs md:text-sm py-2 overflow-hidden relative flex items-center justify-center border-b border-emerald-700">
        <div class="w-full flex space-x-8 space-x-reverse animate-marquee font-bold">
          <span>✨ توصيل سريع لـ 69 ولاية</span>
          <span>•</span>
          <span>🚚 الدفع عند الاستلام</span>
          <span>•</span>
          <span>🛡️ ضمان الجودة 100%</span>
          <span>•</span>
          <span>✨ توصيل سريع لـ 69 ولاية</span>
          <span>•</span>
          <span>🚚 الدفع عند الاستلام</span>
          <span>•</span>
          <span>🛡️ ضمان الجودة 100%</span>
        </div>
      </div>

      <ShippingIsland server:defer />

      <!-- ================= HERO SECTION ================= -->
      <section class="relative w-full h-[85vh] md:h-[90vh] bg-slate-900 flex flex-col justify-end overflow-hidden">
        <div class="absolute inset-0 z-0">
          <!-- IMAGE 1: Hero Main Banner (من الـ API) -->
          <img 
            src={heroImg} 
            alt={product.name} 
            class="w-full h-full object-cover opacity-60 scale-105 transform transition-transform duration-[10s] hover:scale-110"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/70 to-slate-900/20"></div>
        </div>

        <div class="relative z-10 px-6 pb-16 md:pb-24 max-w-3xl mx-auto text-center w-full animate-fade-in">
          <div class="inline-flex items-center gap-2 bg-red-600/90 backdrop-blur-sm text-white text-xs font-bold px-4 py-1.5 rounded-full mb-6 shadow-xl border border-red-500 animate-pulse">
            <span class="w-2 h-2 bg-white rounded-full"></span>
            الكمية محدودة جداً! سارع بالطلب
          </div>
          <h1 class="text-4xl md:text-6xl font-black text-white mb-4 leading-tight drop-shadow-lg">
            {product.name}
          </h1>
          <p class="text-lg md:text-xl text-gray-300 mb-8 max-w-xl mx-auto font-light leading-relaxed">
            أناقة تبين قيمتك. تصميم عصري مستوحى من أعرق الماركات، مخدوم سبيسيال للرجل الأنيق.
          </p>
          
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="#order-section-wrapper" class="group flex items-center justify-center gap-3 w-full sm:w-auto bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 text-white font-black text-lg px-10 py-4 rounded-2xl shadow-[0_10px_40px_-10px_rgba(16,185,129,0.8)] transition-all duration-300 transform hover:-translate-y-1">
              اطلب درك - الدفع عند الاستلام
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
      </section>

      <!-- ================= TRUST BADGES ================= -->
      <section class="py-6 bg-white border border-slate-100 shadow-xl relative z-20 -mt-10 mx-4 rounded-3xl max-w-4xl md:mx-auto backdrop-blur-xl bg-white/90">
        <div class="grid grid-cols-3 gap-2 md:gap-6 divide-x divide-x-reverse divide-slate-100 text-center px-2">
          <div class="flex flex-col items-center p-2 animate-fade-in delay-100">
            <div class="bg-slate-50 text-slate-800 p-3.5 rounded-2xl mb-3 shadow-inner">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 md:h-8 md:w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <span class="text-xs md:text-sm font-black text-slate-800">الدفع عند الاستلام</span>
            <span class="text-[10px] md:text-xs text-slate-500 mt-1 hidden md:block">خلص كي تلحقك السلعة</span>
          </div>
          <div class="flex flex-col items-center p-2 animate-fade-in delay-200">
            <div class="bg-slate-50 text-slate-800 p-3.5 rounded-2xl mb-3 shadow-inner">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 md:h-8 md:w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" /></svg>
            </div>
            <span class="text-xs md:text-sm font-black text-slate-800">توصيل سريع</span>
            <span class="text-[10px] md:text-xs text-slate-500 mt-1 hidden md:block">لـ 69 ولاية جزائرية</span>
          </div>
          <div class="flex flex-col items-center p-2 animate-fade-in delay-300">
            <div class="bg-slate-50 text-slate-800 p-3.5 rounded-2xl mb-3 shadow-inner">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 md:h-8 md:w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.956 11.956 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            </div>
            <span class="text-xs md:text-sm font-black text-slate-800">ضمان الجودة</span>
            <span class="text-[10px] md:text-xs text-slate-500 mt-1 hidden md:block">ستانلس ستيل 100%</span>
          </div>
        </div>
      </section>

      <!-- ================= VISUAL STORYTELLING (GALLERY) ================= -->
      <section class="py-20 px-4 max-w-5xl mx-auto space-y-24">
        
        <!-- Story 1: Material & Quality -->
        <div class="flex flex-col md:flex-row items-center gap-10 md:gap-16 animate-fade-in">
          <div class="w-full md:w-1/2 relative">
            <div class="absolute -inset-4 bg-emerald-100 rounded-[3rem] transform -rotate-3 z-0"></div>
            <!-- IMAGE 2: Product Detail Close-up (من الـ API) -->
            <img 
              src={featImg1} 
              alt="جودة الستانلس ستيل" 
              class="relative z-10 w-full rounded-3xl shadow-2xl aspect-square object-cover hover:scale-105 transition-transform duration-500 border-4 border-white" 
            />
          </div>
          <div class="w-full md:w-1/2 space-y-6 text-center md:text-right">
            <div class="inline-block bg-slate-100 text-slate-600 font-bold px-4 py-2 rounded-lg text-sm">الجودة أولاً 💎</div>
            <h2 class="text-3xl md:text-4xl font-black text-slate-900 leading-tight">ما يكحال، ما يصدد!</h2>
            <p class="text-lg md:text-xl text-slate-600 leading-relaxed font-light">
              مخدوم من أجود أنواع <span class="text-emerald-600 font-bold">الستانلس ستيل الحر (Stainless Steel)</span>. البراسلي تاعنا مقاوم للماء والعرق، دوش بيه وعوم بيه بلا ما تخاف يفقد اللمعان تاعو.
            </p>
            <ul class="space-y-3 text-slate-700 font-medium text-right inline-block mx-auto md:mx-0">
              <li class="flex items-center gap-3"><svg class="w-5 h-5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> مقاوم للصدأ 100%</li>
              <li class="flex items-center gap-3"><svg class="w-5 h-5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> لا يسبب حساسية الجلد</li>
              <li class="flex items-center gap-3"><svg class="w-5 h-5 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> لمعان يدوم طويلاً</li>
            </ul>
          </div>
        </div>

        <!-- Story 2: Packaging & Gifting -->
        <div class="flex flex-col md:flex-row-reverse items-center gap-10 md:gap-16 animate-fade-in">
          <div class="w-full md:w-1/2 relative">
             <div class="absolute -inset-4 bg-slate-200 rounded-[3rem] transform rotate-3 z-0"></div>
            <!-- IMAGE 3: Box & Packaging (من الـ API) -->
            <img 
              src={featImg2} 
              alt="علبة البراسلي الفاخرة" 
              class="relative z-10 w-full rounded-3xl shadow-2xl aspect-square object-cover hover:scale-105 transition-transform duration-500 border-4 border-white" 
            />
          </div>
          <div class="w-full md:w-1/2 space-y-6 text-center md:text-right">
            <div class="inline-block bg-slate-100 text-slate-600 font-bold px-4 py-2 rounded-lg text-sm">فكرة هدية 🎁</div>
            <h2 class="text-3xl md:text-4xl font-black text-slate-900 leading-tight">الهدية المثالية ليك ولا لعزيز عليك</h2>
            <p class="text-lg md:text-xl text-slate-600 leading-relaxed font-light">
              البريزونتاسيون هي كلش! البراسلي يجيك في <span class="text-slate-900 font-bold">علبة فخمة</span> تزيد النص في قيمتو. كادو بارفي تفرح بيه روحك ولا تهديه لشخص عزيز عليك.
            </p>
             <a href="#order-section-wrapper" class="inline-flex items-center justify-center gap-2 bg-slate-900 hover:bg-slate-800 text-white font-bold px-8 py-3 rounded-xl transition-all">
              احجز قطعتك الآن
            </a>
          </div>
        </div>
      </section>

      <!-- ================= ORDER FORM SECTION (DO NOT BREAK) ================= -->
      <section id="order-section-wrapper" class="py-20 px-4 scroll-mt-6 bg-slate-50">
        <div class="max-w-2xl mx-auto text-center mb-10">
          <span class="inline-block py-1 px-3 rounded-full bg-red-100 text-red-600 text-sm font-bold mb-4">🔥 العرض ينتهي قريباً</span>
          <h2 class="text-3xl md:text-5xl font-black text-slate-900 mb-4 tracking-tight">عمر الفورمولار لتحت وحنا نعيطولك</h2>
          <p class="text-slate-500 text-lg">الدفع راهو عند الاستلام، يعني ما تخلص والو درك حتى تلحقك السلعة ليدك وتقلبها.</p>
        </div>

        <div class="max-w-xl mx-auto">
          <div class="bg-white rounded-[2rem] shadow-2xl p-6 md:p-10 border border-slate-100 relative overflow-hidden">
            <!-- الديكور الزجاجي خلف الفورم -->
            <div class="absolute -top-32 -right-32 w-64 h-64 bg-emerald-400 rounded-full mix-blend-multiply filter blur-3xl opacity-10"></div>
            
            <div class="relative z-10">
              <OrderForm
                product={product}
                content={content}
                fieldErrors={fieldErrors}
                serverError={serverError}
                basePrice={basePrice}
                defaultVariant={defaultVariant ?? null}
                cur={cur}
                isRTL={isRTL}
                offers={product.offers}
                defaultVariantId={defaultVariantId}
                isOutOfStock={isOutOfStock}
                otpEnabled={config.otpEnabled === true}
                turnstileEnabled={config.turnstileEnabled === true}
                turnstileSiteKey={config.turnstileSiteKey ?? null}
                pages={config.pages ?? []}
                formPolicy={config.checkoutForm}
                landingPageSlug={lp.slug}
              />
            </div>
          </div>
          
          <div class="mt-8 flex flex-col md:flex-row items-center justify-center gap-4 text-slate-500 text-sm bg-white py-3 px-6 rounded-2xl border border-slate-100 shadow-sm">
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-500" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
              </svg>
              <span>معلوماتك مشفرة ومحمية بالكامل</span>
            </div>
            <span class="hidden md:block text-slate-300">|</span>
            <div class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-500" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
              </svg>
              <span>لا تدفع شيئاً حتى تستلم طلبك</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= STICKY MOBILE CTA ================= -->
      <!-- يظهر فقط في الموبايل ويبقى ثابت في الأسفل لتسهيل الطلب -->
      <div id="sticky-cta" class="md:hidden fixed bottom-0 inset-x-0 p-4 bg-white/90 backdrop-blur-xl border-t border-slate-200 z-50 shadow-[0_-10px_30px_-10px_rgba(0,0,0,0.1)] transition-transform duration-300 transform translate-y-0">
        <a href="#order-section-wrapper" class="flex items-center justify-center w-full bg-gradient-to-r from-emerald-600 to-emerald-500 text-white font-black text-lg py-4 rounded-2xl shadow-lg active:scale-95 transition-all">
          اطلب درك (الدفع عند الاستلام)
        </a>
      </div>

    </div>
  )}

  {!product && (
    <div class="flex flex-col items-center justify-center py-24 px-6 text-center bg-slate-50 min-h-screen" dir="rtl">
      <div class="bg-white p-8 rounded-[2rem] shadow-2xl border border-red-50 max-w-md w-full">
        <div class="w-20 h-20 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <h1 class="text-2xl font-black text-slate-900 mb-3">عذراً، المنتج غير متاح</h1>
        <p class="text-slate-500">لم يتم العثور على صفحة الهبوط أو أن الرابط غير صحيح.</p>
      </div>
    </div>
  )}
</StoreLayout>

<!-- السكريبتات الأساسية (DO NOT TOUCH)[span_4](start_span)[span_4](end_span) -->
<script src="../theme/scripts/product.ts"></script>
<script src="../theme/scripts/otp-step.ts"></script>
<script src="../theme/scripts/turnstile-field.ts"></script>
<script src="../theme/scripts/track-abandonment.ts"></script>

<!-- سكريبت إخفاء زر الموبايل الثابت عند الوصول للفورمولار -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const stickyCta = document.getElementById('sticky-cta');
    const orderSection = document.getElementById('order-section-wrapper');
    
    if (stickyCta && orderSection) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            stickyCta.classList.add('translate-y-[150%]', 'opacity-0');
          } else {
            stickyCta.classList.remove('translate-y-[150%]', 'opacity-0');
          }
        });
      }, { threshold: 0.15 });
      
      observer.observe(orderSection);
    }
  });
</script>
