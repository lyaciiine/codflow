        <div class="relative grid grid-cols-1 gap-7 sm:grid-cols-3 sm:gap-5">
          <div aria-hidden="true" class="lp-step-line absolute start-[16.66%] end-[16.66%] top-6 hidden border-t border-dashed border-[#B9D3C4] sm:block"></div>
          <article class="lp-reveal relative text-center">
            <div class="relative z-10 mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-[#CFE1D6] bg-white text-base font-black text-[#176044] shadow-[0_5px_16px_-10px_rgba(19,65,43,0.35)]">1</div>
            <h3 class="mt-4 text-base font-extrabold text-[#183A2C]">عمّر معلوماتك</h3>
            <p class="mx-auto mt-2 max-w-xs text-sm leading-7 text-[#687C71]">الاسم، رقم الهاتف، والعنوان تاع التوصيل.</p>
          </article>
          <article class="lp-reveal relative text-center">
            <div class="relative z-10 mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-[#CFE1D6] bg-white text-base font-black text-[#176044] shadow-[0_5px_16px_-10px_rgba(19,65,43,0.35)]">2</div>
            <h3 class="mt-4 text-base font-extrabold text-[#183A2C]">راجع الطلب</h3>
            <p class="mx-auto mt-2 max-w-xs text-sm leading-7 text-[#687C71]">تأكد من الخيارات والسعر ومصاريف التوصيل.</p>
          </article>
          <article class="lp-reveal relative text-center">
            <div class="relative z-10 mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-[#CFE1D6] bg-white text-base font-black text-[#176044] shadow-[0_5px_16px_-10px_rgba(19,65,43,0.35)]">3</div>
            <h3 class="mt-4 text-base font-extrabold text-[#183A2C]">خلّص كي توصلك</h3>
            <p class="mx-auto mt-2 max-w-xs text-sm leading-7 text-[#687C71]">الدفع يكون عند الاستلام، حسب تفاصيل طلبك.</p>
          </article>
        </div>
        <div class="lp-reveal mt-9 text-center">
          <a href="#order-section-wrapper" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-[#BFD7C9] bg-white px-5 py-3 text-sm font-extrabold text-[#176044] transition hover:border-[#176044] hover:bg-[#F0F7F2] focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-3 focus-visible:outline-[#6BBF94]">
            <span>نروح للفورمولار</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </section>

      <!-- عنوان الفورمولار -->
      <section class="px-4 pb-6 pt-2 text-center sm:px-6 sm:pb-8" aria-labelledby="order-title">
        <div class="lp-reveal mx-auto max-w-2xl">
          <h2 id="order-title" class="text-2xl font-black tracking-[-0.025em] text-[#14382A] sm:text-3xl">كمّل طلبك من هنا</h2>
          <p class="mt-3 text-sm leading-7 text-[#62766B] sm:text-base">عمّر المعلومات الصحيحة باش يوصلك الطلب بلا مشاكل.</p>
        </div>
      </section>

      <!-- الفورمولار الأصلي: نفس الـ id ونفس props -->
      <div class="mx-auto max-w-xl px-4" id="order-section-wrapper">
        <div class="rounded-2xl border border-[#E0EAE3] bg-white p-4 shadow-[0_18px_44px_-28px_rgba(17,60,40,0.32)] sm:rounded-3xl sm:p-7">
          <OrderForm
            product={product}
            content={content}
            fieldErrors={fieldErrors}
            serverError={serverError}
            basePrice={basePrice}
            defaultVariant={defaultVariant ?? null}
            cur={cur}
            isRTL={isRTL}
            offers={product.offers}
            defaultVariantId={defaultVariantId}
            isOutOfStock={isOutOfStock}
            otpEnabled={config.otpEnabled === true}
            turnstileEnabled={config.turnstileEnabled === true}
            turnstileSiteKey={config.turnstileSiteKey ?? null}
            pages={config.pages ?? []}
            formPolicy={config.checkoutForm}
            landingPageSlug={lp.slug}
          />
        </div>
        <div class="lp-reveal mt-4 grid grid-cols-1 gap-2.5 pb-4 text-center sm:grid-cols-3 sm:gap-3 sm:pb-0">
          <div class="flex items-center justify-center gap-2 rounded-xl bg-white px-3 py-3 text-xs font-bold text-[#4F6C5D]">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-[#176044]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 19 6v5c0 4.5-3 7.5-7 10-4-2.5-7-5.5-7-10V6l7-3Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg>
            <span>راجع معلوماتك قبل التأكيد</span>
          </div>
          <div class="flex items-center justify-center gap-2 rounded-xl bg-white px-3 py-3 text-xs font-bold text-[#4F6C5D]">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-[#176044]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg>
            <span>الدفع عند الاستلام</span>
          </div>
          <div class="flex items-center justify-center gap-2 rounded-xl bg-white px-3 py-3 text-xs font-bold text-[#4F6C5D]">
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-[#176044]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"/><circle cx="7.5" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/></svg>
            <span>توصيل لـ69 ولاية</span>
          </div>
        </div>
      </div>

      <!-- CTA ثابت للهاتف فقط، يختفي كي الفورمولار يدخل للشاشة -->
      <div id="mobile-sticky-cta" class="lp-mobile-sticky fixed inset-x-0 bottom-0 z-40 px-3 pt-3 md:hidden" role="region" aria-label="اطلب المنتج">
        <div class="mx-auto flex max-w-xl items-center gap-3 rounded-2xl border border-[#D8E7DE] bg-white p-3 shadow-[0_-8px_32px_-18px_rgba(13,57,37,0.35)]">
          <div class="min-w-0 flex-1 ps-1">
            <p class="text-[11px] font-bold text-[#6A7F73]">السعر</p>
            <p class="truncate text-lg font-black leading-tight text-[#123A2B]">{formatPrice(basePrice)} <span class="text-xs font-bold">{cur}</span></p>
          </div>
          <a href="#order-section-wrapper" class="lp-cta lp-sticky-button lp-cta-pulse inline-flex min-h-12 shrink-0 items-center justify-center gap-2 rounded-xl bg-[#176044] px-5 py-3 text-sm font-extrabold text-white transition hover:bg-[#104C35] focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-[#6BBF94]">
            <span>اطلب الآن</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 rtl:rotate-180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </div>
  )}

  {!product && (
    <div class="flex flex-col items-center justify-center bg-[#F6F9F7] px-6 py-24 text-center" dir={isRTL ? "rtl" : "ltr"}>
      <div class="max-w-lg rounded-3xl border border-[#DFEAE3] bg-white p-8 shadow-sm sm:p-10">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="mx-auto mb-4 h-10 w-10 text-[#176044]" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4m0 4h.01"/></svg>
        <h1 class="text-2xl font-black text-[#15392A]">ما لقيناش صفحة المنتج</h1>
        <p class="mt-3 text-sm leading-7 text-[#63776C]">تأكد من رابط صفحة الهبوط في الإعدادات، ومن بعد عاود جرّب.</p>
      </div>
    </div>
  )}
</StoreLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 1rem;
  }

  .lp-page {
    --lp-green: #176044;
    --lp-ink: #153128;
    font-family: "Tajawal", "Noto Kufi Arabic", system-ui, sans-serif;
    -webkit-tap-highlight-color: transparent;
  }

  .lp-announcement {
    background: #124b35;
    padding-top: 0.625rem;
    padding-bottom: 0.625rem;
    padding-inline: max(1rem, env(safe-area-inset-left));
  }

  .lp-hero-art {
    isolation: isolate;
  }

  .lp-art-ring {
    animation: lp-ring-drift 14s ease-in-out infinite alternate;
  }

  .lp-cta-pulse {
    animation: lp-cta-pulse 3.2s ease-in-out infinite;
  }

  .lp-feature {
    transition: border-color 220ms ease, transform 220ms ease, background-color 220ms ease;
  }

  .lp-feature:hover {
    border-color: #BFD9C9;
    transform: translateY(-3px);
    background-color: #FCFEFC;
  }

  .lp-mobile-sticky {
    padding-bottom: calc(0.65rem + env(safe-area-inset-bottom));
  }

  .lp-mobile-sticky[hidden] {
    display: none !important;
  }

  .lp-step-line {
    top: 1.45rem;
  }

  .lp-page ::selection {
    color: #FFFFFF;
    background: #176044;
  }

  .lp-page a {
    text-underline-offset: 0.2em;
  }

  .lp-page a:focus-visible {
    outline-offset: 4px;
  }

  .lp-page img {
    color: #466355;
  }

  .lp-page .lp-reveal {
    opacity: 1;
    transform: none;
    filter: none;
  }

  .lp-motion-ready .lp-reveal:not(.is-visible) {
    opacity: 0;
    transform: translateY(16px);
    filter: blur(2px);
  }

  .lp-motion-ready .lp-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    transition: opacity 620ms cubic-bezier(0.16, 1, 0.3, 1), transform 620ms cubic-bezier(0.16, 1, 0.3, 1), filter 620ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes lp-cta-pulse {
    0%, 100% { box-shadow: 0 12px 24px -12px rgba(17, 91, 60, 0.55); }
    50% { box-shadow: 0 15px 30px -10px rgba(17, 91, 60, 0.7); }
  }

  @keyframes lp-ring-drift {
    from { transform: translate3d(0, 0, 0) rotate(0deg); }
    to { transform: translate3d(-6px, 8px, 0) rotate(12deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto !important;
    }

    .lp-page *,
    .lp-page *::before,
    .lp-page *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }

    .lp-motion-ready .lp-reveal:not(.is-visible) {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  @media (max-width: 767px) {
    .lp-story-wrap .lp-reveal {
      transition-delay: 0ms !important;
    }
  }
</style>

<script>
  const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (!reducedMotionQuery.matches && "IntersectionObserver" in window) {
    const revealTargets = Array.from(document.querySelectorAll<HTMLElement>(".lp-reveal"));
    document.documentElement.classList.add("lp-motion-ready");

    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: "0px 0px -36px 0px" });

    revealTargets.forEach((target) => revealObserver.observe(target));
  }

  const stickyCta = document.getElementById("mobile-sticky-cta");
  const orderTarget = document.getElementById("order-section-wrapper");

  if (stickyCta && orderTarget && "IntersectionObserver" in window) {
    const orderObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const formIsVisible = entry.isIntersecting && entry.intersectionRatio > 0.04;
        stickyCta.toggleAttribute("hidden", formIsVisible);
        stickyCta.setAttribute("aria-hidden", formIsVisible ? "true" : "false");
      });
    }, { threshold: [0, 0.04, 0.12] });

    orderObserver.observe(orderTarget);
  } else if (stickyCta && orderTarget) {
    const syncStickyCta = () => {
      const bounds = orderTarget.getBoundingClientRect();
      const formIsVisible = bounds.top < window.innerHeight && bounds.bottom > 0;
      stickyCta.toggleAttribute("hidden", formIsVisible);
      stickyCta.setAttribute("aria-hidden", formIsVisible ? "true" : "false");
    };
    window.addEventListener("scroll", syncStickyCta, { passive: true });
    window.addEventListener("resize", syncStickyCta);
    syncStickyCta();
  }
</script>

