---
import StoreLayout from "@/theme/layouts/StoreLayout.astro";
import OrderForm from "@/theme/components/order/OrderForm.astro";
import ShippingIsland from "@/theme/components/product/ShippingIsland.astro";
import { getStoreContext } from "@/theme/config/store";
import { fetchLandingPageBySlug } from "@/core/api/client";
import { actions } from "astro:actions";
import { isInputError } from "astro:actions";

const storeCtx = await getStoreContext();
const { config, content, isRTL } = storeCtx;

// استدعاء صفحة الهبوط بالـ Slug الصحيح
const lp = await fetchLandingPageBySlug("lacoste"); 
const product = lp?.product;

const cur = config.currencySymbol;
const defaultVariant = product?.hasVariants
  ? (product.variants.find((v: any) => v.isDefault) ?? product.variants[0])
  : null;
const basePrice = defaultVariant?.price ?? product?.price ?? 0;
const comparePrice = defaultVariant?.compareAtPrice ?? product?.compareAtPrice ?? null;
const isOutOfStock = product?.trackInventory && product.inventory === 0;
const defaultVariantId = defaultVariant?.id ?? null;

// معالجة إرسال الطلبية
const result = Astro.getActionResult(actions.placeOrder);
if (result?.data?.orderNumber) {
  return Astro.redirect(
    `/thank-you?order=${encodeURIComponent(result.data.orderNumber)}&total=${result.data.total}&oid=${encodeURIComponent(result.data.orderId ?? "")}`,
    303,
  );
}
const fieldErrors = isInputError(result?.error) ? result.error.fields : {};
const serverError = result?.error && !isInputError(result.error) ? result.error.message : null;
---

<StoreLayout config={config} content={content} title={lp?.metaTitle || "عرض خاص - براسلي متروبول"} marketing={true}>
  
  <style>
    /* أنيميشن الدخول والظهور السلس */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
      animation: fadeInUp 0.8s ease-out forwards;
      opacity: 0;
    }
    .delay-100 { animation-delay: 100ms; }
    .delay-200 { animation-delay: 200ms; }
    .delay-300 { animation-delay: 300ms; }
    
    html { scroll-behavior: smooth; }
  </style>

  {product && (
    <div class="bg-slate-50 min-h-screen font-sans selection:bg-emerald-200" dir="rtl">
      
      <!-- جسر البيانات اللازم للسكريبتات والولايات (DO NOT TOUCH) -->
      <div
        id="page-data"
        class="sr-only"
        data-variants={JSON.stringify(product.variants ?? [])}
        data-base-price={basePrice}
        data-compare-price={comparePrice ?? ""}
        data-cur={cur}
        data-is-rtl={isRTL ? "1" : "0"}
        data-shipping-label={content.shippingLabel}
        data-shipping-calc={content.shippingCalculated}
        data-shipping-free={content.shippingFree}
        data-total-label={content.totalLabel}
        data-commune-placeholder={content.formCommunePlaceholder}
        data-commune-loading={content.formCommuneLoading}
        data-commune-disabled={content.formCommuneDisabled}
        data-offers={JSON.stringify(product.offers ?? [])}
        data-track-inventory={product.trackInventory ? "1" : "0"}
        data-out-of-stock-label={content.outOfStock}
        data-qty-max-stock={content.qtyMaxStock}
        data-inventory={String(product.inventory ?? 0)}
        data-pixel-id={lp.tracking?.pixelId ?? config.pixelId ?? ""}
        data-phone-invalid={content.formPhoneInvalid}
        data-product-id={product.id}
        data-product-name={product.name}
      />

      <ShippingIsland server:defer />

      <!-- ================= HERO SECTION ================= -->
      <section class="relative w-full h-[85vh] md:h-[90vh] bg-slate-900 flex flex-col justify-end overflow-hidden">
        <div class="absolute inset-0 z-0">
          <!-- IMAGE 1: Hero Main Banner (استبدل الرابط بصورة البراسلي الرئيسية تكون بالطول للموبايل) -->
          <img 
            src="https://placehold.co/800x1200/1e293b/ffffff?text=Hero+Image+(Main+Bracelet)" 
            alt="براسلي متروبول الفاخر" 
            class="w-full h-full object-cover opacity-70 scale-105 transform transition-transform duration-[10s] hover:scale-110"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/60 to-transparent"></div>
        </div>

        <div class="relative z-10 px-6 pb-20 md:pb-32 max-w-3xl mx-auto text-center w-full animate-fade-in">
          <div class="inline-block bg-white/20 backdrop-blur-md border border-white/30 text-white text-xs font-bold px-4 py-1.5 rounded-full mb-4 shadow-xl">
            ✨ الأكثر مبيعاً هذا الأسبوع
          </div>
          <h1 class="text-4xl md:text-6xl font-black text-white mb-4 leading-tight">
            أناقة تكمل <span class="text-emerald-400">إطلالتك</span>.
          </h1>
          <p class="text-lg md:text-xl text-gray-200 mb-8 max-w-xl mx-auto font-light">
            براسلي متروبول الجديد. تصميم عصري مستوحى من أعرق الماركات العالمية، مخدوم سبيسيال للرجل الأنيق.
          </p>
          <a href="#order-section-wrapper" class="inline-flex items-center justify-center gap-2 w-full md:w-auto bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-lg px-10 py-4 rounded-full shadow-[0_0_40px_-10px_rgba(16,185,129,0.7)] transition-all duration-300 transform hover:-translate-y-1">
            اطلب الآن - الدفع عند الاستلام
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </section>

      <!-- ================= TRUST BADGES ================= -->
      <section class="py-8 bg-white border-b border-gray-100 shadow-sm relative z-20 -mt-6 mx-4 rounded-2xl max-w-4xl md:mx-auto">
        <div class="grid grid-cols-3 gap-2 divide-x divide-x-reverse divide-gray-100 text-center px-2">
          <div class="flex flex-col items-center p-2 animate-fade-in delay-100">
            <div class="bg-emerald-50 text-emerald-600 p-3 rounded-full mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <span class="text-xs md:text-sm font-bold text-slate-800">الدفع عند الاستلام</span>
            <span class="text-[10px] md:text-xs text-slate-500 mt-1">خلص كي تلحقك السلعة</span>
          </div>
          <div class="flex flex-col items-center p-2 animate-fade-in delay-200">
            <div class="bg-emerald-50 text-emerald-600 p-3 rounded-full mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" /></svg>
            </div>
            <span class="text-xs md:text-sm font-bold text-slate-800">توصيل سريع</span>
            <span class="text-[10px] md:text-xs text-slate-500 mt-1">لـ 69 ولاية جزائرية</span>
          </div>
          <div class="flex flex-col items-center p-2 animate-fade-in delay-300">
            <div class="bg-emerald-50 text-emerald-600 p-3 rounded-full mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.956 11.956 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            </div>
            <span class="text-xs md:text-sm font-bold text-slate-800">ضمان الجودة</span>
            <span class="text-[10px] md:text-xs text-slate-500 mt-1">ستانلس ستيل 100%</span>
          </div>
        </div>
      </section>

      <!-- ================= VISUAL STORYTELLING (GALLERY) ================= -->
      <section class="py-16 px-4 max-w-4xl mx-auto space-y-16">
        
        <!-- Story 1: Material & Quality -->
        <div class="flex flex-col md:flex-row items-center gap-8 animate-fade-in">
          <div class="w-full md:w-1/2 overflow-hidden rounded-3xl shadow-xl aspect-square md:aspect-[4/3]">
            <!-- IMAGE 2: Product Detail Close-up (صورة مقربة تبين جودة المعدن ولمعان البراسلي) -->
            <img 
              src="https://placehold.co/600x600/f8fafc/1e293b?text=Detail+Close-up" 
              alt="جودة الستانلس ستيل" 
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" 
            />
          </div>
          <div class="w-full md:w-1/2 space-y-4 text-center md:text-right">
            <h2 class="text-3xl font-black text-slate-900">ما يكحال، ما يصدد!</h2>
            <p class="text-lg text-slate-600 leading-relaxed">
              مخدوم من أجود أنواع <span class="text-emerald-600 font-bold">الستانلس ستيل الحر (Stainless Steel)</span>. البراسلي تاعنا مقاوم للماء والعرق، يعني تقدر تدوش بيه وتعيش بيه حياتك اليومية بلا ما تخاف يفقد اللمعان تاعو.
            </p>
          </div>
        </div>

        <!-- Story 2: Packaging & Gifting -->
        <div class="flex flex-col md:flex-row-reverse items-center gap-8 animate-fade-in">
          <div class="w-full md:w-1/2 overflow-hidden rounded-3xl shadow-xl aspect-square md:aspect-[4/3]">
            <!-- IMAGE 3: Box & Packaging (صورة البراسلي داخل علبة فاخرة) -->
            <img 
              src="https://placehold.co/600x600/f8fafc/1e293b?text=Luxury+Packaging" 
              alt="علبة البراسلي الفاخرة" 
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" 
            />
          </div>
          <div class="w-full md:w-1/2 space-y-4 text-center md:text-right">
            <h2 class="text-3xl font-black text-slate-900">الهدية المثالية ليك ولا لعزيز عليك</h2>
            <p class="text-lg text-slate-600 leading-relaxed">
              البريزونتاسيون هي كلش! البراسلي يجيك في <span class="text-emerald-600 font-bold">علبة فخمة</span> تزيد النص في قيمتو. كادو بارفي تفرح بيه روحك ولا تهديه لشخص عزيز عليك في أي مناسبة.
            </p>
          </div>
        </div>
      </section>

      <!-- ================= SOCIAL PROOF / REVIEWS ================= -->
      <section class="py-12 bg-slate-900 text-white">
        <div class="max-w-4xl mx-auto px-4">
          <h2 class="text-2xl md:text-3xl font-bold text-center mb-10">وش قالو الزبائن لي شراو علينا؟</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Review Card 1 -->
            <div class="bg-white/10 backdrop-blur-lg border border-white/10 p-6 rounded-2xl">
              <div class="flex text-yellow-400 mb-3">
                {"★★★★★".split("").map((star) => <span class="text-xl">{star}</span>)}
              </div>
              <p class="text-gray-300 italic mb-4">"نوعية روعة وتوصيل كان سريع، البراسلي يبان غالي بزاف ومطابق للتصاور. يعطيكم الصحة خدمة نقية."</p>
              <div class="font-bold text-emerald-400">- أمين (الجزائر العاصمة)</div>
            </div>
            <!-- Review Card 2 -->
            <div class="bg-white/10 backdrop-blur-lg border border-white/10 p-6 rounded-2xl">
              <div class="flex text-yellow-400 mb-3">
                {"★★★★★".split("").map((star) => <span class="text-xl">{star}</span>)}
              </div>
              <p class="text-gray-300 italic mb-4">"شريتو كادو لخويا في عيد ميلادو وفرح بيه بزاف. الكاليتي تاع الستانلس ستيل باينة صحيحة والعلبة فخمة."</p>
              <div class="font-bold text-emerald-400">- سفيان (وهران)</div>
            </div>
          </div>
        </div>
      </section>

      <!-- ================= ORDER FORM SECTION (DO NOT BREAK) ================= -->
      <section id="order-section-wrapper" class="py-16 px-4 scroll-mt-6">
        <div class="max-w-xl mx-auto text-center mb-8">
          <h2 class="text-3xl md:text-4xl font-black text-slate-900 mb-2">اطلب درك واستفاد من العرض</h2>
          <p class="text-slate-500">عمر الاستمارة لتحت وراح نعيطولك باش نكونفيرميو معاك الطلبية</p>
        </div>

        <div class="max-w-xl mx-auto">
          <div class="bg-white rounded-3xl shadow-2xl p-6 md:p-8 border-4 border-emerald-50 relative overflow-hidden">
            <!-- الديكور الزجاجي خلف الفورم -->
            <div class="absolute -top-24 -right-24 w-48 h-48 bg-emerald-400 rounded-full mix-blend-multiply filter blur-3xl opacity-20"></div>
            
            <div class="relative z-10">
              <OrderForm
                product={product}
                content={content}
                fieldErrors={fieldErrors}
                serverError={serverError}
                basePrice={basePrice}
                defaultVariant={defaultVariant ?? null}
                cur={cur}
                isRTL={isRTL}
                offers={product.offers}
                defaultVariantId={defaultVariantId}
                isOutOfStock={isOutOfStock}
                otpEnabled={config.otpEnabled === true}
                turnstileEnabled={config.turnstileEnabled === true}
                turnstileSiteKey={config.turnstileSiteKey ?? null}
                pages={config.pages ?? []}
                formPolicy={config.checkoutForm}
                landingPageSlug={lp.slug}
              />
            </div>
          </div>
          
          <div class="mt-6 flex items-center justify-center gap-2 text-slate-500 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-500" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
            </svg>
            <span>معلوماتك مشفرة ومحمية بالكامل</span>
          </div>
        </div>
      </section>

      <!-- ================= STICKY MOBILE CTA ================= -->
      <!-- يظهر فقط في الموبايل ويبقى ثابت في الأسفل لتسهيل الطلب -->
      <div id="sticky-cta" class="md:hidden fixed bottom-0 inset-x-0 p-4 bg-white/95 backdrop-blur-md border-t border-gray-200 z-50 shadow-[0_-4px_20px_-5px_rgba(0,0,0,0.15)] transition-transform duration-300 transform translate-y-0">
        <a href="#order-section-wrapper" class="flex items-center justify-center w-full bg-emerald-600 text-white font-bold text-lg py-4 rounded-xl shadow-lg active:scale-95 transition-all">
          اطلب الآن (الدفع عند الاستلام)
        </a>
      </div>

    </div>
  )}

  {!product && (
    <div class="flex flex-col items-center justify-center py-24 px-6 text-center bg-slate-50 min-h-screen" dir="rtl">
      <div class="bg-white p-8 rounded-2xl shadow-xl border border-red-100 max-w-md w-full">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-red-500 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <h1 class="text-2xl font-black text-slate-800 mb-2">عذراً، المنتج غير متاح</h1>
        <p class="text-slate-500">لم يتم العثور على صفحة الهبوط أو أن الرابط غير صحيح.</p>
      </div>
    </div>
  )}
</StoreLayout>

<!-- السكريبتات الأساسية (DO NOT TOUCH) -->
<script src="../theme/scripts/product.ts"></script>
<script src="../theme/scripts/otp-step.ts"></script>
<script src="../theme/scripts/turnstile-field.ts"></script>
<script src="../theme/scripts/track-abandonment.ts"></script>

<!-- سكريبت إخفاء زر الموبايل الثابت عند الوصول للفورمولار (UX Enhancement) -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const stickyCta = document.getElementById('sticky-cta');
    const orderSection = document.getElementById('order-section-wrapper');
    
    if (stickyCta && orderSection) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          // إذا ظهر الفورمولار في الشاشة بنسبة 20%، نخفي الزر الثابت
          if (entry.isIntersecting) {
            stickyCta.classList.add('translate-y-full', 'opacity-0');
          } else {
            stickyCta.classList.remove('translate-y-full', 'opacity-0');
          }
        });
      }, { threshold: 0.2 });
      
      observer.observe(orderSection);
    }
  });
</script>
