---
import StoreLayout from "@/theme/layouts/StoreLayout.astro";
import OrderForm from "@/theme/components/order/OrderForm.astro";
import ShippingIsland from "@/theme/components/product/ShippingIsland.astro";
import { getStoreContext } from "@/theme/config/store";
import { fetchLandingPageBySlug } from "@/core/api/client";
import { actions } from "astro:actions";
import { isInputError } from "astro:actions";

const storeCtx = await getStoreContext();
const { config, content, isRTL } = storeCtx;

const lp = await fetchLandingPageBySlug("lacoste");
const product = lp?.product;

const cur = config?.currencySymbol;
const defaultVariant = product?.hasVariants
  ? (product?.variants?.find((v: any) => v?.isDefault) ?? product?.variants?.[0] ?? null)
  : null;
const basePrice = defaultVariant?.price ?? product?.price ?? 0;
const comparePrice = defaultVariant?.compareAtPrice ?? product?.compareAtPrice ?? null;
const isOutOfStock = product?.trackInventory && product?.inventory === 0;
const defaultVariantId = defaultVariant?.id ?? null;

// ===== متغيرات تقديمية فقط (ديزاين) =====
const productName = product?.name ?? "Bracelet Metropole";
const headline = "أناقة تكمل إطلالتك";
const hasDiscount = Number(comparePrice) > Number(basePrice) && Number(basePrice) > 0;
const discountPercent = hasDiscount
  ? Math.round((1 - Number(basePrice) / Number(comparePrice)) * 100)
  : null;

// الصور: كنقراو product.images ولا lp.images، وكنقبلو strings ولا objects فيها url / src / image
const rawImages: any = product?.images ?? lp?.images ?? [];
const productImages: string[] = (Array.isArray(rawImages) ? rawImages : [])
  .map((img: any) => (typeof img === "string" ? img : (img?.url ?? img?.src ?? img?.image ?? "")))
  .filter((src: any) => typeof src === "string" && src.length > 0);
const heroImage = productImages[0] ?? null;
const galleryImages = productImages.slice(0, 4);

const features = [
  {
    title: "تصميم أيقوني",
    text: "الوصلات على شكل H والوصلات الوسطى بنقشة petit piqué، روح Lacoste في كل تفصيلة.",
  },
  {
    title: "قياس واضح: 19 سم",
    text: "قياس الدائرة الداخلية 19 سم. إلا احتجت تقصيرو، تنجم تديرو عند حرفي ساعات ولا مجوهرات.",
  },
  {
    title: "فيرموار ديبلوانت",
    text: "قفل سهل وآمن يتفتح ويتقفل بسرعة، مناسب للاستعمال اليومي.",
  },
  {
    title: "مواد هيبوألرجينية",
    text: "مناسب حتى للبشرة الحساسة، وما يسببش حساسية في الغالب.",
  },
];

// معالجة إرسال الطلبية
const result = Astro.getActionResult(actions.placeOrder);
if (result?.data?.orderNumber) {
  return Astro.redirect(
    `/thank-you?order=${encodeURIComponent(result.data.orderNumber)}&total=${result.data.total}&oid=${encodeURIComponent(result.data.orderId ?? "")}`,
    303,
  );
}
const fieldErrors = isInputError(result?.error) ? result.error.fields : {};
const serverError = result?.error && !isInputError(result.error) ? result.error.message : null;
---

<StoreLayout config={config} content={content} title={lp?.metaTitle || "عرض خاص"} marketing={true}>
  {product && (
    <div class="min-h-screen bg-stone-50 pb-28 md:pb-16" dir={isRTL ? "rtl" : "ltr"}>

      <!-- جسر البيانات اللازم للسكريبتات والولايات -->
      <div
        id="page-data"
        class="sr-only"
        data-variants={JSON.stringify(product?.variants ?? [])}
        data-base-price={basePrice}
        data-compare-price={comparePrice ?? ""}
        data-cur={cur}
        data-is-rtl={isRTL ? "1" : "0"}
        data-shipping-label={content?.shippingLabel}
        data-shipping-calc={content?.shippingCalculated}
        data-shipping-free={content?.shippingFree}
        data-total-label={content?.totalLabel}
        data-commune-placeholder={content?.formCommunePlaceholder}
        data-commune-loading={content?.formCommuneLoading}
        data-commune-disabled={content?.formCommuneDisabled}
        data-offers={JSON.stringify(product?.offers ?? [])}
        data-track-inventory={product?.trackInventory ? "1" : "0"}
        data-out-of-stock-label={content?.outOfStock}
        data-qty-max-stock={content?.qtyMaxStock}
        data-inventory={String(product?.inventory ?? 0)}
        data-pixel-id={lp?.tracking?.pixelId ?? config?.pixelId ?? ""}
        data-phone-invalid={content?.formPhoneInvalid}
        data-product-id={product?.id}
        data-product-name={product?.name}
      />

      <ShippingIsland server:defer />

      <!-- ===== الهيرو: الصورة + المعلومات + CTA ===== -->
      <header class="bg-white">
        <div class="mx-auto max-w-5xl md:grid md:grid-cols-2 md:items-center md:gap-10 md:px-6 md:py-12">

          <!-- الصور -->
          <div class="relative">
            <div class="aspect-square w-full overflow-hidden bg-stone-100 md:rounded-3xl">
              {heroImage ? (
                <img
                  src={heroImage}
                  alt={productName}
                  class="h-full w-full object-cover"
                  loading="eager"
                  fetchpriority="high"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-stone-200 to-stone-100">
                  <span class="text-7xl font-black text-stone-400">L</span>
                </div>
              )}
            </div>

            {discountPercent !== null && discountPercent > 0 && (
              <span class="absolute start-4 top-4 rounded-full bg-red-600 px-3 py-1 text-sm font-bold text-white shadow">
                -{discountPercent}%
              </span>
            )}

            {galleryImages.length > 1 && (
              <div class="mt-3 grid grid-cols-4 gap-2 px-4 md:px-0">
                {galleryImages.map((src) => (
                  <div class="aspect-square overflow-hidden rounded-xl bg-stone-100 ring-1 ring-stone-200">
                    <img src={src} alt="" loading="lazy" class="h-full w-full object-cover" />
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- المعلومات -->
          <div class="px-5 pb-6 pt-6 md:px-0 md:pt-0">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-red-600">Lacoste · Collection</p>
            <h1 class="mt-2 text-3xl font-black leading-tight text-stone-900 md:text-5xl">{headline}</h1>
            <p class="mt-2 text-lg font-semibold text-stone-700">{productName}</p>
            <p class="mt-3 leading-relaxed text-stone-600">
              روح Lacoste الأيقونية تتجسد بأناقة في سوار Metropole: وصلات على شكل H ووصلات مركزية بنقشة petit piqué. يكمل أي لبسة يومية ولا رسمية.
            </p>

            <div class="mt-5 flex items-end gap-3">
              <span class="text-3xl font-black text-stone-900">
                {basePrice} <span class="text-lg font-bold">{cur}</span>
              </span>
              {hasDiscount && (
                <span class="pb-1 text-base text-stone-400 line-through">
                  {comparePrice} {cur}
                </span>
              )}
            </div>

            <a
              href="#order-section-wrapper"
              class="mt-6 flex w-full items-center justify-center rounded-2xl bg-stone-900 px-6 py-4 text-lg font-extrabold text-white shadow-lg transition hover:bg-stone-800 active:scale-[0.99]"
              aria-disabled={isOutOfStock ? "true" : undefined}
            >
              {isOutOfStock ? (content?.outOfStock || "نفذ من المخزون") : "اطلب دابا"}
            </a>

            <ul class="mt-5 grid grid-cols-3 gap-2 text-center text-xs font-semibold text-stone-700">
              <li class="rounded-xl bg-stone-100 px-2 py-3">الدفع عند الاستلام</li>
              <li class="rounded-xl bg-stone-100 px-2 py-3">توصيل لـ 69 ولاية</li>
              <li class="rounded-xl bg-stone-100 px-2 py-3">طلب سهل وسريع</li>
            </ul>
          </div>

        </div>
      </header>

      <!-- ===== المميزات ===== -->
      <section class="mx-auto max-w-5xl px-5 py-12 md:px-6">
        <h2 class="text-2xl font-black text-stone-900 md:text-3xl">علاش تختار Metropole؟</h2>
        <ul class="mt-6 grid gap-4 md:grid-cols-2">
          {features.map((f, i) => (
            <li class="flex gap-4 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-stone-200">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-stone-900 text-sm font-bold text-white">
                {i + 1}
              </span>
              <div>
                <h3 class="font-bold text-stone-900">{f.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-stone-600">{f.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <!-- ===== فورمولار الطلب ===== -->
      <div class="mx-auto max-w-xl scroll-mt-6 px-4 pb-10 md:px-6" id="order-section-wrapper">
        <div class="rounded-2xl border border-stone-100 bg-white p-6 shadow-xl">
          <h2 class="text-center text-2xl font-black text-stone-900">اطلب دابا</h2>
          <p class="mb-6 mt-2 text-center text-sm text-stone-600">
            املا المعلومات تحت، والخلاص يكون عند الاستلام.
          </p>
          <OrderForm
            product={product}
            content={content}
            fieldErrors={fieldErrors}
            serverError={serverError}
            basePrice={basePrice}
            defaultVariant={defaultVariant ?? null}
            cur={cur}
            isRTL={isRTL}
            offers={product?.offers}
            defaultVariantId={defaultVariantId}
            isOutOfStock={isOutOfStock}
            otpEnabled={config?.otpEnabled === true}
            turnstileEnabled={config?.turnstileEnabled === true}
            turnstileSiteKey={config?.turnstileSiteKey ?? null}
            pages={config?.pages ?? []}
            formPolicy={config?.checkoutForm}
            landingPageSlug={lp?.slug}
          />
        </div>
      </div>

      <!-- ===== شريط CTA ثابت للموبايل ===== -->
      <div
        class="fixed inset-x-0 bottom-0 z-40 border-t border-stone-200 bg-white/95 p-3 backdrop-blur md:hidden"
        style="padding-bottom: calc(0.75rem + env(safe-area-inset-bottom));"
      >
        <a
          href="#order-section-wrapper"
          class="flex items-center justify-between rounded-2xl bg-stone-900 px-5 py-3 text-white shadow-lg"
        >
          <span class="font-extrabold">اطلب دابا</span>
          <span class="font-black">{basePrice} {cur}</span>
        </a>
      </div>

    </div>
  )}

  {!product && (
    <div class="flex flex-col items-center justify-center px-6 py-24 text-center">
      <h1 class="text-2xl font-black text-red-600">عذراً، لم يتم العثور على صفحة الهبوط أو أن الslug خاطئ.</h1>
    </div>
  )}
</StoreLayout>

<!-- السكريبتات الأساسية -->
<script src="../theme/scripts/product.ts"></script>
<script src="../theme/scripts/otp-step.ts"></script>
<script src="../theme/scripts/turnstile-field.ts"></script>
<script src="../theme/scripts/track-abandonment.ts"></script>
