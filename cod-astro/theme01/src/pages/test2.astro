---
import StoreLayout from "@/theme/layouts/StoreLayout.astro";
import OrderForm from "@/theme/components/order/OrderForm.astro";
import ShippingIsland from "@/theme/components/product/ShippingIsland.astro";
import { getStoreContext } from "@/theme/config/store";
import { fetchLandingPageBySlug } from "@/core/api/client";
import { actions } from "astro:actions";
import { isInputError } from "astro:actions";

const storeCtx = await getStoreContext();
const { config, content, isRTL } = storeCtx;

// استدعاء صفحة الهبوط بالـ Slug الصحيح
const lp = await fetchLandingPageBySlug("lacoste"); 
const product = lp?.product;

const cur = config.currencySymbol;
const defaultVariant = product?.hasVariants
  ? (product.variants.find((v: any) => v.isDefault) ?? product.variants[0])
  : null;
const basePrice = defaultVariant?.price ?? product?.price ?? 0;
const comparePrice = defaultVariant?.compareAtPrice ?? product?.compareAtPrice ?? null;
const isOutOfStock = product?.trackInventory && product.inventory === 0;
const defaultVariantId = defaultVariant?.id ?? null;

// معالجة إرسال الطلبية
const result = Astro.getActionResult(actions.placeOrder);
if (result?.data?.orderNumber) {
  return Astro.redirect(
    `/thank-you?order=${encodeURIComponent(result.data.orderNumber)}&total=${result.data.total}&oid=${encodeURIComponent(result.data.orderId ?? "")}`,
    303,
  );
}
const fieldErrors = isInputError(result?.error) ? result.error.fields : {};
const serverError = result?.error && !isInputError(result.error) ? result.error.message : null;

// ─────────────────────────────────────────────────────────────
// متغيرات للديزاين فقط (presentational only)
// ─────────────────────────────────────────────────────────────

const toImgUrl = (img: any): string | null => {
  if (!img) return null;
  if (typeof img === "string") return img;
  return img?.url ?? img?.src ?? img?.image ?? img?.imageUrl ?? img?.original ?? null;
};
const rawImages: any = product?.images ?? lp?.images;
const imageList: any[] = Array.isArray(rawImages) ? rawImages : rawImages ? [rawImages] : [];
if (imageList.length === 0) {
  const single = product?.image ?? product?.thumbnail ?? lp?.image ?? null;
  if (single) imageList.push(single);
}
const gallery: string[] = imageList
  .map(toImgUrl)
  .filter((u: any): u is string => typeof u === "string" && u.length > 0);

const fmt = (n: any) => Number(n ?? 0).toString().replace(/\B(?=(\d{3})+(?!\d))/g, "\u00A0");
const numBase = Number(basePrice ?? 0);
const numCompare = Number(comparePrice ?? 0);
const discountPct =
  numCompare > numBase && numBase > 0 ? Math.round((1 - numBase / numCompare) * 100) : 0;

const icons: Record<string, string> = {
  truck:
    '<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>',
  cash: '<rect width="20" height="12" x="2" y="6" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/>',
  shield:
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
  gem: '<path d="M6 3h12l4 6-10 13L2 9Z"/><path d="M11 3 8 9l4 13 4-13-3-6"/><path d="M2 9h20"/>',
  lock: '<rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  scissors:
    '<circle cx="6" cy="6" r="3"/><path d="M8.12 8.12 12 12"/><path d="M20 4 8.12 15.88"/><circle cx="6" cy="18" r="3"/><path d="M14.8 14.8 20 20"/>',
  down: '<path d="M12 5v14"/><path d="m19 12-7 7-7-7"/>',
};

const trust = [
  { icon: "cash", label: "الدفع عند الاستلام" },
  { icon: "truck", label: "توصيل لـ 69 ولاية" },
  { icon: "shield", label: "مضاد للحساسية" },
];

const features = [
  {
    icon: "gem",
    title: "روح Lacoste في كل تفصيلة",
    text: "حلقات على شكل H، وحلقات وسطية تعيد نقشة الـ petit piqué المعروفة. سوار يبان فيه الذوق من أول نظرة.",
  },
  {
    icon: "lock",
    title: "قفل Déployant",
    text: "قفل مطوي يتسكّر بسهولة ويثبّت السوار مليح في معصمك.",
  },
  {
    icon: "shield",
    title: "مضاد للحساسية",
    text: "Hypoallergénique، لبس مريح على الجلد.",
  },
  {
    icon: "scissors",
    title: "يتقصّر على قياسك",
    text: "إذا حبيتو أقصر، يقدر الساعاتي أو الصايغ يقصّرلك السوار.",
  },
];

const steps = [
  { n: "1", title: "عمّر الفورمولار", text: "الاسم، رقم الهاتف والولاية، وخلاص." },
  { n: "2", title: "نبعثولك الطلب", text: "توصيل سريع لـ 69 ولاية." },
  { n: "3", title: "تستلم وتخلص", text: "الدفع عند الاستلام فقط." },
];
---

<StoreLayout config={config} content={content} title={lp?.metaTitle || "عرض خاص"} marketing={true}>
  {product && (
    <div class="mt-root bg-[#f2f5f0] text-[#0d2418] min-h-screen pb-28" dir={isRTL ? "rtl" : "ltr"}>

      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Reem+Kufi:wght@500;600;700&family=Readex+Pro:wght@300;400;500;600&display=swap"
      />

      <!-- جسر البيانات -->
      <div
        id="page-data"
        class="sr-only"
        data-variants={JSON.stringify(product.variants ?? [])}
        data-base-price={basePrice}
        data-compare-price={comparePrice ?? ""}
        data-cur={cur}
        data-is-rtl={isRTL ? "1" : "0"}
        data-shipping-label={content.shippingLabel}
        data-shipping-calc={content.shippingCalculated}
        data-shipping-free={content.shippingFree}
        data-total-label={content.totalLabel}
        data-commune-placeholder={content.formCommunePlaceholder}
        data-commune-loading={content.formCommuneLoading}
        data-commune-disabled={content.formCommuneDisabled}
        data-offers={JSON.stringify(product.offers ?? [])}
        data-track-inventory={product.trackInventory ? "1" : "0"}
        data-out-of-stock-label={content.outOfStock}
        data-qty-max-stock={content.qtyMaxStock}
        data-inventory={String(product.inventory ?? 0)}
        data-pixel-id={lp.tracking?.pixelId ?? config.pixelId ?? ""}
        data-phone-invalid={content.formPhoneInvalid}
        data-product-id={product.id}
        data-product-name={product.name}
      />

      <ShippingIsland server:defer />

      <!-- شريط الإعلان -->
      <div class="bg-[#04271a] text-[#dfe9e1] text-[13px] leading-none">
        <p class="max-w-5xl mx-auto px-4 py-3 text-center">
          توصيل سريع لـ 69 ولاية <span class="mx-2 text-[#cdee5a]" aria-hidden="true">/</span> الدفع عند الاستلام
        </p>
      </div>

      <!-- ═════════ الهيرو ═════════ -->
      <section class="mt-pique bg-[#063b27] text-[#eef3ee] overflow-hidden">
        <div class="max-w-5xl mx-auto px-5 pt-9 pb-12 md:py-16 md:grid md:grid-cols-2 md:gap-14 md:items-center">

          <div class="text-start">
            <h1
              class="mt-display mt-rise text-[2.75rem] leading-[1.18] font-bold sm:text-6xl"
              style="--d:0ms; text-wrap:balance;"
            >
              أناقة تكمل إطلالتك
            </h1>

            <p
              class="mt-rise mt-5 text-[1.0625rem] leading-8 text-[#c3d6c9] max-w-md font-light"
              style="--d:120ms;"
            >
              <span class="font-medium text-[#eef3ee]">Bracelet Metropole</span> بتصميم Lacoste. حلقات H ونقشة الـ piqué
              في سوار واحد يكمّل لبستك، من النهار للعشية.
            </p>

            <div class="mt-rise mt-8 flex items-end gap-4 flex-wrap" style="--d:240ms;">
              <div>
                <p class="text-[13px] text-[#a9c2b1] mb-1">السعر</p>
                <p class="mt-display text-[2.5rem] leading-none font-bold tabular-nums flex items-baseline gap-2">
                  <span dir="ltr">{fmt(basePrice)}</span>
                  <span class="text-xl font-medium text-[#c3d6c9]">{cur}</span>
                </p>
              </div>
              {numCompare > numBase && (
                <div class="pb-1 flex items-center gap-2">
                  <p class="text-[#a9c2b1] line-through tabular-nums text-lg decoration-[#a9c2b1]/70 flex items-center gap-1">
                    <span dir="ltr">{fmt(comparePrice)}</span>
                    <span>{cur}</span>
                  </p>
                  {discountPct > 0 && (
                    <span class="bg-[#cdee5a] text-[#0d2418] text-[13px] font-semibold rounded-full px-3 py-1">
                      وفّر {discountPct}%
                    </span>
                  )}
                </div>
              )}
            </div>

            <div class="mt-rise mt-7" style="--d:360ms;">
              <a
                id="mt-hero-cta"
                href="#order-section-wrapper"
                class="mt-cta group inline-flex w-full sm:w-auto items-center justify-center gap-3 h-14 px-9 rounded-2xl bg-[#eef3ee] text-[#063b27] font-semibold text-lg shadow-[0_14px_30px_-12px_rgba(0,0,0,0.55)] transition-all duration-300 hover:bg-white hover:-translate-y-0.5 active:translate-y-0"
              >
                {isOutOfStock ? "نفدت الكمية" : "اطلب الآن"}
                <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons.down} />
              </a>
              <p class="mt-3 text-[13px] text-[#a9c2b1]">ما تخلص والو حتى تستلم طلبك.</p>
            </div>
          </div>

          <!-- المعرض -->
          <div class="mt-rise mt-10 md:mt-0" style="--d:200ms;">
            <div class="relative rounded-[2rem] bg-[#f6f6f6] ring-1 ring-white/20 shadow-[0_30px_60px_-30px_rgba(0,0,0,0.7)] overflow-hidden">
              {gallery.length > 0 ? (
                <div id="mt-gallery" class="mt-snap flex overflow-x-auto snap-x snap-mandatory" dir="ltr" aria-label="تصاور المنتج">
                  {gallery.map((src, i) => (
                    <div class="shrink-0 w-full snap-center aspect-[4/5] overflow-hidden p-6 flex items-center justify-center">
                      <img
                        src={src}
                        alt={`Bracelet Metropole ${i + 1}`}
                        class="w-full h-full object-contain mix-blend-multiply drop-shadow-sm"
                        loading={i === 0 ? "eager" : "lazy"}
                        decoding="async"
                      />
                    </div>
                  ))}
                </div>
              ) : (
                <div class="aspect-[4/5] flex items-center justify-center p-10">
                  <svg viewBox="0 0 400 400" class="w-full h-full max-w-xs" role="img" aria-label="Bracelet Metropole">
                    <circle cx="200" cy="200" r="132" fill="none" stroke="#9fb0a6" stroke-width="34" stroke-dasharray="27 8" />
                    <circle cx="200" cy="200" r="104" fill="none" stroke="#9fb0a6" stroke-opacity="0.5" stroke-width="1.5" />
                  </svg>
                </div>
              )}

              {discountPct > 0 && (
                <span class="absolute top-4 start-4 bg-[#063b27] text-[#eef3ee] text-[13px] font-semibold rounded-full px-3 py-1">
                  -{discountPct}%
                </span>
              )}
              {gallery.length > 1 && (
                <div id="mt-dots" class="absolute bottom-4 inset-x-0 flex justify-center gap-2" dir="ltr" aria-hidden="true">
                  {gallery.map((_, i) => (
                    <span class={`h-2 rounded-full bg-[#063b27] transition-all duration-300 ${i === 0 ? "w-6 opacity-100" : "w-2 opacity-30"}`}></span>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>
      </section>

      <!-- ═════════ شريط الثقة ═════════ -->
      <section class="bg-[#04271a] text-[#dfe9e1]">
        <ul class="max-w-5xl mx-auto grid grid-cols-3 divide-x divide-x-reverse divide-white/10">
          {trust.map((t) => (
            <li class="flex flex-col items-center gap-2 px-2 py-5 text-center">
              <svg class="w-6 h-6 text-[#cdee5a]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[t.icon]} />
              <span class="text-[13px] leading-5 font-medium">{t.label}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- ═════════ التفاصيل ═════════ -->
      <section class="max-w-5xl mx-auto px-5 py-16 md:py-24">
        <div class="md:grid md:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)] md:gap-16 md:items-start">

          <div>
            <h2 class="mt-display text-[2.25rem] leading-[1.2] font-bold sm:text-5xl" style="text-wrap:balance;">
              تفاصيل تفرّق
            </h2>
            <p class="mt-4 text-[#44564b] leading-8 max-w-sm">
              كل حاجة في Metropole مدروسة، من شكل الحلقات حتى القفل.
            </p>

            <div class="mt-10 relative mx-auto md:mx-0 w-60 h-60 flex items-center justify-center">
              <svg viewBox="0 0 240 240" class="absolute inset-0 w-full h-full" aria-hidden="true">
                <circle cx="120" cy="120" r="108" fill="none" stroke="#063b27" stroke-width="16" stroke-dasharray="15 5" stroke-opacity="0.9" />
                <circle cx="120" cy="120" r="88" fill="none" stroke="#063b27" stroke-opacity="0.25" stroke-width="1" />
              </svg>
              <div class="relative text-center">
                <p class="mt-display text-7xl leading-none font-bold tabular-nums text-[#063b27]">19</p>
                <p class="mt-2 text-[15px] font-medium text-[#0d2418]">سم</p>
                <p class="text-[13px] text-[#44564b]">المحيط الداخلي</p>
              </div>
            </div>
          </div>

          <ul class="mt-12 md:mt-0 divide-y divide-[#0d2418]/12 border-y border-[#0d2418]/12">
            {features.map((f) => (
              <li class="flex gap-4 py-6">
                <span class="shrink-0 w-11 h-11 rounded-xl bg-[#063b27] text-[#cdee5a] flex items-center justify-center">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[f.icon]} />
                </span>
                <div>
                  <h3 class="mt-display text-xl font-semibold leading-snug">{f.title}</h3>
                  <p class="mt-1.5 text-[#44564b] leading-7">{f.text}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ═════════ كيفاش تطلب ═════════ -->
      <section class="mt-pique bg-[#063b27] text-[#eef3ee]">
        <div class="max-w-5xl mx-auto px-5 py-16 md:py-20">
          <h2 class="mt-display text-[2.25rem] leading-[1.2] font-bold sm:text-5xl max-w-xl" style="text-wrap:balance;">
            تطلب بسهولة، وتخلص كي يوصلك
          </h2>
          <ol class="mt-10 grid gap-8 md:grid-cols-3 md:gap-10">
            {steps.map((s) => (
              <li class="flex gap-5 md:block">
                <span class="mt-display shrink-0 text-5xl leading-none font-bold text-[#cdee5a] tabular-nums md:block md:mb-4">{s.n}</span>
                <div>
                  <h3 class="mt-display text-xl font-semibold">{s.title}</h3>
                  <p class="mt-1.5 text-[#c3d6c9] leading-7">{s.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- 📦 فورمولار الدفع -->
      <section class="pt-14 md:pt-20">
        <div class="max-w-xl mx-auto px-3 sm:px-4 scroll-mt-4" id="order-section-wrapper">
          <div class="text-center mb-7 px-2">
            <h2 class="mt-display text-[2rem] leading-[1.25] font-bold sm:text-4xl" style="text-wrap:balance;">
              اطلب Bracelet Metropole الآن
            </h2>
            <p class="mt-3 text-[#44564b] leading-7">
              عمّر معلوماتك، والدفع عند الاستلام. توصيل لـ 69 ولاية.
            </p>
          </div>

          <div class="bg-white rounded-3xl shadow-[0_24px_50px_-28px_rgba(6,59,39,0.45)] border border-[#063b27]/10 overflow-hidden p-2 sm:p-4 w-full">
            <OrderForm
              product={product}
              content={content}
              fieldErrors={fieldErrors}
              serverError={serverError}
              basePrice={basePrice}
              defaultVariant={defaultVariant ?? null}
              cur={cur}
              isRTL={isRTL}
              offers={product.offers}
              defaultVariantId={defaultVariantId}
              isOutOfStock={isOutOfStock}
              otpEnabled={config.otpEnabled === true}
              turnstileEnabled={config.turnstileEnabled === true}
              turnstileSiteKey={config.turnstileSiteKey ?? null}
              pages={config.pages ?? []}
              formPolicy={config.checkoutForm}
              landingPageSlug={lp.slug}
            />
          </div>
        </div>
      </section>

      <!-- شريط الطلب الثابت (موبايل) -->
      <div
        id="mt-sticky"
        class="fixed inset-x-0 bottom-0 z-40 translate-y-full pointer-events-none transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
        aria-hidden="true"
      >
        <div class="bg-[#063b27]/95 backdrop-blur-md border-t border-white/10 px-4 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))]">
          <div class="max-w-xl mx-auto flex items-center justify-between gap-4">
            <div class="text-[#eef3ee]">
              <p class="text-[12px] text-[#a9c2b1] leading-none mb-1">Bracelet Metropole</p>
              <p class="mt-display text-2xl leading-none font-bold tabular-nums flex items-baseline gap-1">
                <span dir="ltr">{fmt(basePrice)}</span>
                <span class="text-sm font-medium text-[#c3d6c9]">{cur}</span>
              </p>
            </div>
            <a
              href="#order-section-wrapper"
              tabindex="-1"
              class="inline-flex items-center justify-center h-12 px-8 rounded-xl bg-[#eef3ee] text-[#063b27] font-semibold text-base active:scale-[0.98] transition-transform"
            >
              {isOutOfStock ? "نفدت الكمية" : "اطلب الآن"}
            </a>
          </div>
        </div>
      </div>

      <!-- إظهار/إخفاء الشريط الثابت -->
      <script is:inline>
        (function () {
          try {
            var bar = document.getElementById("mt-sticky");
            var hero = document.getElementById("mt-hero-cta");
            var order = document.getElementById("order-section-wrapper");
            if (!bar || !hero || !order || !("IntersectionObserver" in window)) return;
            var heroSeen = true;
            var orderSeen = false;
            var update = function () {
              var show = !heroSeen && !orderSeen;
              bar.classList.toggle("translate-y-full", !show);
              bar.classList.toggle("pointer-events-none", !show);
              bar.setAttribute("aria-hidden", show ? "false" : "true");
              var link = bar.querySelector("a");
              if (link) link.setAttribute("tabindex", show ? "0" : "-1");
            };
            var g = document.getElementById("mt-gallery");
            var dots = document.querySelectorAll("#mt-dots span");
            if (g && dots.length) {
              g.addEventListener("scroll", function () {
                var i = Math.round(Math.abs(g.scrollLeft) / (g.clientWidth || 1));
                dots.forEach(function (d, k) {
                  d.classList.toggle("w-6", k === i);
                  d.classList.toggle("opacity-100", k === i);
                  d.classList.toggle("w-2", k !== i);
                  d.classList.toggle("opacity-30", k !== i);
                });
              }, { passive: true });
            }
            new IntersectionObserver(function (e) { heroSeen = e[0].isIntersecting; update(); }).observe(hero);
            new IntersectionObserver(function (e) { orderSeen = e[0].isIntersecting; update(); }, { threshold: 0.05 }).observe(order);
          } catch (err) {}
        })();
      </script>

    </div>
  )}

  {!product && (
    <div class="flex flex-col items-center justify-center py-24 px-6 text-center">
      <h1 class="text-2xl font-black text-red-600">عذراً، لم يتم العثور على صفحة الهبوط أو أن الslug خاطئ.</h1>
    </div>
  )}
</StoreLayout>

<!-- السكريبتات الأساسية -->
<script src="../theme/scripts/product.ts"></script>
<script src="../theme/scripts/otp-step.ts"></script>
<script src="../theme/scripts/turnstile-field.ts"></script>
<script src="../theme/scripts/track-abandonment.ts"></script>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  .mt-root {
    font-family: "Readex Pro", system-ui, -apple-system, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
    scrollbar-color: #063b27 #f2f5f0;
  }
  .mt-display {
    font-family: "Reem Kufi", "Readex Pro", system-ui, sans-serif;
    letter-spacing: 0;
  }

  /* نقشة petit piqué */
  .mt-pique {
    background-image:
      radial-gradient(circle at center, rgba(255, 255, 255, 0.075) 0 1px, transparent 1.6px),
      radial-gradient(circle at center, rgba(255, 255, 255, 0.075) 0 1px, transparent 1.6px);
    background-size: 8px 8px, 8px 8px;
    background-position: 0 0, 4px 4px;
  }

  .mt-snap {
    scrollbar-width: none;
  }
  .mt-snap::-webkit-scrollbar {
    display: none;
  }

  /* حركة الدخول */
  @keyframes mt-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(6px);
    }
    to {
      opacity: 1;
