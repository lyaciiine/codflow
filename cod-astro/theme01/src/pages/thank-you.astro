---
import { getStoreContext } from "@/theme/config/store";
import { fetchOrderTracking } from "@/core/api/client";
import { Icon } from "astro-icon/components";
import "@/theme/styles/global.css";

const orderNumber = Astro.url.searchParams.get("order") ?? "";
const orderId = Astro.url.searchParams.get("oid") ?? "";

const [storeCtx, tracking] = await Promise.all([
  getStoreContext(),
  fetchOrderTracking(orderId),
]);
const { config, content, isRTL } = storeCtx;

const total = Astro.url.searchParams.get("total");
const totalFormatted = total
  ? parseInt(total).toLocaleString("ar-DZ")
  : null;

if (!orderNumber) {
  return Astro.redirect("/");
}

const pixelId = tracking?.pixelId ?? null;
const checkoutEvent = tracking?.event ?? null;
const totalNum = total ? parseInt(total) : null;

const steps = [
  { icon: "heroicons:phone", title: content.step1Title, sub: content.step1Sub },
  { icon: "heroicons:cube",  title: content.step2Title, sub: content.step2Sub },
  { icon: "heroicons:truck", title: content.step3Title, sub: content.step3Sub },
];
---

<!DOCTYPE html>
<html lang={isRTL ? "ar" : "en"} dir={isRTL ? "rtl" : "ltr"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{content.thankYouPageTitle} — {config.name}</title>
    <meta name="robots" content="noindex,nofollow" />
    
    <!-- خط Cairo من Google Fonts باش الكتيبة تخرج شابة مباشرة -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
  </head>
  
  <body class="min-h-screen bg-gray-50 flex items-center justify-center p-4 sm:p-8" style="font-family: 'Cairo', sans-serif;">
    
    <div class="max-w-md w-full bg-white rounded-[2rem] shadow-xl p-8 sm:p-10 text-center border border-gray-100">
      
      <div class="w-20 h-20 bg-emerald-50 text-emerald-500 rounded-full flex items-center justify-center mx-auto mb-6 shadow-sm border border-emerald-100 animate-spring">
        <Icon name="heroicons:check-circle" class="w-12 h-12" />
      </div>

      <h1 class="text-3xl font-extrabold mb-2 text-gray-900 tracking-tight">
        {content.thankYouTitle}
      </h1>
      <p class="font-semibold text-gray-500 mb-8 px-2">
        {content.thankYouSubtitle}
      </p>

      <div class="bg-gray-50 rounded-2xl p-5 mb-8 text-start border border-gray-100">
        <div class="flex items-center justify-between pb-4 border-b border-gray-200 border-dashed mb-4">
          <span class="text-xs font-bold text-gray-500 uppercase tracking-widest">
            {content.orderNumberLabel}
          </span>
          <span class="font-extrabold text-lg text-gray-900 tracking-wider">
            {orderNumber}
          </span>
        </div>

        {totalFormatted && (
          <div class="flex items-center justify-between">
            <span class="text-sm font-bold text-gray-500">{content.totalAmountLabel}</span>
            <span class="font-extrabold text-2xl text-emerald-600">
              {totalFormatted} <span class="text-sm font-bold opacity-80 uppercase">{config.currencySymbol}</span>
            </span>
          </div>
        )}
      </div>

      <div class="grid grid-cols-3 gap-2">
        {steps.map((step) => (
          <div class="flex flex-col items-center text-center gap-1.5">
            <div class="w-10 h-10 bg-gray-50 text-gray-700 rounded-xl flex items-center justify-center shadow-sm border border-gray-100">
              <Icon name={step.icon} class="w-5 h-5" />
            </div>
            <p class="text-xs font-bold text-gray-800 leading-tight">{step.title}</p>
            <p class="text-[0.6rem] font-semibold text-gray-400">{step.sub}</p>
          </div>
        ))}
      </div>

    </div>

    {pixelId && checkoutEvent && (
      <script type="text/javascript" set:html={`
      (function() {
        if (typeof fbq !== 'function') return;
        var eventId = ${JSON.stringify(orderId)};
        if (!eventId) return;
        var total   = ${JSON.stringify(totalNum)};
        var eventName = ${JSON.stringify(checkoutEvent)};
        fbq('trackSingle', ${JSON.stringify(pixelId)}, eventName, total ? { value: total, currency: 'DZD' } : {}, { eventID: eventId });
      })();
      `} />
    )}

    <script is:inline define:vars={{ orderNumber, orderId }}>
      (function () {
        try {
          var sessionId = sessionStorage.getItem("cod_session_id");
          if (!sessionId) return;
          sessionStorage.removeItem("cod_session_id");
          fetch("/api/abandoned/convert", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ sessionId: sessionId, orderId: orderId, orderNumber: orderNumber }),
            keepalive: true,
          }).catch(function () {});
        } catch (e) {}
      })();
    </script>

    <script>
      import { clearCart } from "@/theme/scripts/cart";
      clearCart();
    </script>
  </body>
</html>
