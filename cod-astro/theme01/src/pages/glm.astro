<!-- سكريبت الديزاين: أنيميشن الظهور + الشريط السفلي الثابت -->
<script is:inline>
  (function () {
    var d = document;
    d.documentElement.classList.add("has-js");

    var reduced = false;
    try {
      reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    } catch (e) {}

    // 1) ظهور العناصر عند السكرول
    var revealEls = Array.prototype.slice.call(d.querySelectorAll(".lp-reveal"));
    if (reduced || !("IntersectionObserver" in window)) {
      for (var i = 0; i < revealEls.length; i++) revealEls[i].classList.add("lp-visible");
    } else {
      var io = new IntersectionObserver(
        function (entries) {
          for (var j = 0; j < entries.length; j++) {
            if (entries[j].isIntersecting) {
              entries[j].target.classList.add("lp-visible");
              io.unobserve(entries[j].target);
            }
          }
        },
        { threshold: 0.1, rootMargin: "0px 0px -36px 0px" }
      );
      for (var k = 0; k < revealEls.length; k++) io.observe(revealEls[k]);
    }

    // 2) الشريط السفلي: يتخبى كي يبان فورمولاير الطلب (أو كي نتجاوزوه)
    var sticky = d.getElementById("lp-sticky-cta");
    var orderWrapper = d.getElementById("order-section-wrapper");
    if (sticky && orderWrapper && "IntersectionObserver" in window) {
      var so = new IntersectionObserver(
        function (entries) {
          var e = entries[0];
          var past = e.boundingClientRect && e.boundingClientRect.top < 0;
          sticky.classList.toggle("lp-hidden", e.isIntersecting || past);
        },
        { threshold: 0 }
      );
      so.observe(orderWrapper);
    } else if (sticky) {
      sticky.classList.add("lp-hidden");
    }
  })();
</script>