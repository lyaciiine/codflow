---
import StoreLayout from "@/theme/layouts/StoreLayout.astro";
import OrderForm from "@/theme/components/order/OrderForm.astro";
import ShippingIsland from "@/theme/components/product/ShippingIsland.astro";
import { getStoreContext } from "@/theme/config/store";
import { fetchLandingPageBySlug } from "@/core/api/client";
import { actions } from "astro:actions";
import { isInputError } from "astro:actions";

const storeCtx = await getStoreContext();
const { config, content, isRTL } = storeCtx;

// استدعاء صفحة الهبوط بالـ Slug الصحيح (مثلاً: lacoste أو اسم صفحة الهبوط اللي راك دايرها في الداشبورد)
const lp = await fetchLandingPageBySlug("lacoste");
const product = lp?.product;

const cur = config.currencySymbol;
const defaultVariant = product?.hasVariants
  ? (product.variants.find((v: any) => v.isDefault) ?? product.variants[0])
  : null;
const basePrice = defaultVariant?.price ?? product?.price ?? 0;
const comparePrice = defaultVariant?.compareAtPrice ?? product?.compareAtPrice ?? null;
const isOutOfStock = product?.trackInventory && product.inventory === 0;
const defaultVariantId = defaultVariant?.id ?? null;

// معالجة إرسال الطلبية
const result = Astro.getActionResult(actions.placeOrder);
if (result?.data?.orderNumber) {
  return Astro.redirect(
    `/thank-you?order=${encodeURIComponent(result.data.orderNumber)}&total=${result.data.total}&oid=${encodeURIComponent(result.data.orderId ?? "")}`,
    303,
  );
}
const fieldErrors = isInputError(result?.error) ? result.error.fields : {};
const serverError = result?.error && !isInputError(result.error) ? result.error.message : null;

/* =====================================================================
   متغيرات عرض فقط (Presentational) — إضافية للديزاين الجديد
   ما بدّلت ولا حذفت حتى متغير قديم؛ هذي كلها آمنة وقابلة للتعديل
   ===================================================================== */

// عدد الولايات المستعمل في نصوص الصفحة (بدّلو إذا تغيّرت تغطية التوصيل)
const WILAYA_COUNT = 69;

// --- قراءة التصاور بشكل دفاعي ---
// نجربو product.images أولاً، وإلا lp.images.
// كل عنصر يقبل: string مباشر، أو object فيه url / src / image
const asArray = (v: any): any[] => (Array.isArray(v) ? v : []);
const toImageSrc = (img: any): string | null => {
  if (typeof img === "string") return img.trim() ? img : null;
  if (img && typeof img === "object") {
    const s = img.url ?? img.src ?? img.image ?? null;
    return typeof s === "string" && s.trim() ? s : null;
  }
  return null;
};
const productImgs = asArray((product as any)?.images);
const lpImgs = asArray((lp as any)?.images);
const gallery: string[] = (productImgs.length ? productImgs : lpImgs)
  .map(toImageSrc)
  .filter((s: string | null): s is string => s !== null);
const heroImage = gallery[0] ?? null;
const storyImages = gallery.slice(1);

// --- حسابات الأثمنة (للعرض فقط) ---
const toNum = (v: any): number | null => {
  const n = typeof v === "number" ? v : typeof v === "string" ? Number(v) : NaN;
  return Number.isFinite(n) ? n : null;
};
const fmt = (v: any): string => {
  const n = toNum(v);
  return n === null ? String(v ?? "") : n.toLocaleString("fr-FR");
};
const basePriceNum = toNum(basePrice);
const comparePriceNum = toNum(comparePrice);
const hasDiscount = basePriceNum !== null && comparePriceNum !== null && comparePriceNum > basePriceNum;
const discountPct =
  hasDiscount && basePriceNum !== null && comparePriceNum !== null
    ? Math.round(((comparePriceNum - basePriceNum) / comparePriceNum) * 100)
    : null;
const priceDisplay = fmt(basePrice);
const comparePriceDisplay = hasDiscount ? fmt(comparePrice) : null;
const savedDisplay =
  hasDiscount && basePriceNum !== null && comparePriceNum !== null
    ? fmt(comparePriceNum - basePriceNum)
    : null;

// --- المحتوى التسويقي (دارجة جزائرية) ---
const trustBadges = [
  { icon: "banknote", title: "الدفع عند الاستلام", text: "تدفع كي توصلك السلعة" },
  { icon: "truck", title: "توصيل سريع", text: `لـ ${WILAYA_COUNT} ولاية` },
  { icon: "badge", title: "منتج أصلي", text: "جودة لاكوست مضمونة" },
  { icon: "headset", title: "خدمة زبائن", text: "فريقنا معاك خطوة بخطوة" },
];

const features = [
  { icon: "sparkles", title: "أصالة لاكوست", text: "مايونز على شكل H وحلقات وسطية بنقشة petit piqué — توقيع العلامة في كل حلقة." },
  { icon: "ruler", title: "مقاس مدروس: 19 سم", text: "المحيط الداخلي 19 سم — مقاس مضبوط يليق مع غالبية المعاصم." },
  { icon: "lock", title: "إبزيم déployant", text: "قفل دوبويان متين — يفتح ويسد بسلاسة، وأمان كامل للبراسلي." },
  { icon: "leaf", title: "مضاد للحساسية", text: "مواد hypoallergénique لطيفة على البشرة — مناسبة حتى للبشرة الحساسة." },
  { icon: "scissors", title: "مقاس قابل للتعديل", text: "تحب مقاس أصغر؟ البراسلي يتقصّر بسهولة عند الساعاتي أو الصائغ." },
];

const storyBlocks = [
  { title: "توقيع petit piqué", text: "حلقات H وحلقات وسطية كتعاود نقشة petit piqué الشهيرة — الـ DNA تاع لاكوست في كل تفصيلة.", src: storyImages[0] ?? null },
  { title: "إبزيم déployant", text: "قفل صلب وسهل الاستعمال — يضمن أن البراسلي يبقى في معصمك مهما تحركت في نهارك.", src: storyImages[1] ?? null },
  { title: "راحة طول اليوم", text: "خفيف على المعصم ومضاد للحساسية — من الصباح حتى السهرة بلا أي إزعاج.", src: storyImages[2] ?? null },
];

const steps = [
  { title: "اضغط على «اطلب دابا»", text: "الزر ينزّلك مباشرة لفورمولاير الطلب لي تحت." },
  { title: "عمّر المعلومات", text: "الاسم، رقم التيليفون، الولاية والبلدية — دقيقتين صافي." },
  { title: "استنى مكالمتنا", text: "نتصلو بيك للتأكيد ونوجهولك البراسلي — تدفع كي توصلك السلعة." },
];

const guarantees = [
  "الدفع عند الاستلام — بلا بطاقة بنكية",
  "تأكيد الطلب بالتيليفون قبل الإرسال",
  `توصيل سريع لـ ${WILAYA_COUNT} ولاية`,
];
---

<style is:global>
  /* ظهور العناصر عند السكرول (يتفعّل فقط إذا كان JS شغّال) */
  html.has-js .lp-reveal {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.7s cubic-bezier(0.21, 0.61, 0.35, 1),
      transform 0.7s cubic-bezier(0.21, 0.61, 0.35, 1);
    will-change: opacity, transform;
  }
  html.has-js .lp-reveal.lp-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* نبضة ناعمة على زر الطلب الرئيسي */
  @keyframes lp-cta-pulse {
    0% { box-shadow: 0 0 0 0 rgba(4, 120, 87, 0.35), 0 12px 24px -12px rgba(4, 120, 87, 0.6); }
    70% { box-shadow: 0 0 0 14px rgba(4, 120, 87, 0), 0 12px 24px -12px rgba(4, 120, 87, 0.6); }
    100% { box-shadow: 0 0 0 0 rgba(4, 120, 87, 0), 0 12px 24px -12px rgba(4, 120, 87, 0.6); }
  }
  .lp-cta-pulse { animation: lp-cta-pulse 2.6s cubic-bezier(0.4, 0, 0.6, 1) infinite; }

  /* الشريط السفلي الثابت: يختفي كي يبان الفورمولاير */
  #lp-sticky-cta { transition: transform 0.35s ease, opacity 0.35s ease; }
  #lp-sticky-cta.lp-hidden { transform: translateY(110%); opacity: 0; pointer-events: none; }

  /* قلب السهم في RTL (احتياط حتى بدون rtl: variant تاع Tailwind) */
  [dir="rtl"] .lp-flip { transform: rotate(180deg); }

  /* سكرول ناعم للروابط الداخلية */
  @media (prefers-reduced-motion: no-preference) {
    html { scroll-behavior: smooth; }
  }

  /* احترام تفضيل تقليل الحركة */
  @media (prefers-reduced-motion: reduce) {
    html.has-js .lp-reveal { transition: none !important; opacity: 1 !important; transform: none !important; }
    .lp-cta-pulse { animation: none !important; }
    .animate-ping { animation: none !important; }
    #lp-sticky-cta { transition: none !important; }
    html { scroll-behavior: auto !important; }
  }
</style>

<StoreLayout config={config} content={content} title={lp?.metaTitle || "عرض خاص"} marketing={true}>
  {product && (
    <div class="min-h-screen bg-white pb-[calc(6rem_+_env(safe-area-inset-bottom))] md:pb-16" dir={isRTL ? "rtl" : "ltr"}>

      <!-- تفعيل أنيميشن الظهور فقط إذا كان JS شغّال (باش المحتوى يبان حتى بلا JS) -->
      <script is:inline>document.documentElement.classList.add("has-js");</script>

      <!-- جسر البيانات اللازم للسكريبتات والولايات -->
      <div
        id="page-data"
        class="sr-only"
        data-variants={JSON.stringify(product.variants ?? [])}
        data-base-price={basePrice}
        data-compare-price={comparePrice ?? ""}
        data-cur={cur}
        data-is-rtl={isRTL ? "1" : "0"}
        data-shipping-label={content.shippingLabel}
        data-shipping-calc={content.shippingCalculated}
        data-shipping-free={content.shippingFree}
        data-total-label={content.totalLabel}
        data-commune-placeholder={content.formCommunePlaceholder}
        data-commune-loading={content.formCommuneLoading}
        data-commune-disabled={content.formCommuneDisabled}
        data-offers={JSON.stringify(product.offers ?? [])}
        data-track-inventory={product.trackInventory ? "1" : "0"}
        data-out-of-stock-label={content.outOfStock}
        data-qty-max-stock={content.qtyMaxStock}
        data-inventory={String(product.inventory ?? 0)}
        data-pixel-id={lp.tracking?.pixelId ?? config.pixelId ?? ""}
        data-phone-invalid={content.formPhoneInvalid}
        data-product-id={product.id}
        data-product-name={product.name}
      />

      <ShippingIsland server:defer />

      <!-- شريط الإعلان العلوي -->
      <div class="bg-emerald-950 text-white">
        <div class="mx-auto flex max-w-2xl flex-wrap items-center justify-center gap-x-5 gap-y-1 px-4 py-2.5 text-center text-xs font-semibold sm:text-sm">
          <span class="inline-flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-4 w-4 text-emerald-300"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
            <span>توصيل سريع لـ {WILAYA_COUNT} ولاية</span>
          </span>
          <span class="hidden h-1 w-1 rounded-full bg-emerald-400/60 sm:block" aria-hidden="true"></span>
          <span class="inline-flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-4 w-4 text-emerald-300"><rect width="20" height="12" x="2" y="6" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01"/><path d="M18 12h.01"/></svg>
            <span>الدفع عند الاستلام</span>
          </span>
          <span class="hidden h-1 w-1 rounded-full bg-emerald-400/60 sm:block" aria-hidden="true"></span>
          <span class="hidden items-center gap-1.5 sm:inline-flex">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-4 w-4 text-emerald-300"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.287 1.288L3 12l5.8 1.9a2 2 0 0 1 1.288 1.287L12 21l1.9-5.8a2 2 0 0 1 1.287-1.288L21 12l-5.8-1.9a2 2 0 0 1-1.288-1.287Z"/></svg>
            <span>عرض خاص لفترة محدودة</span>
          </span>
        </div>
      </div>

      <!-- القسم الرئيسي (Hero) -->
      <section class="relative overflow-hidden bg-white pb-10 pt-7 sm:pt-10">
        <div class="pointer-events-none absolute -top-28 left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-emerald-100/70 blur-3xl" aria-hidden="true"></div>

        <div class="relative mx-auto max-w-lg px-4 sm:max-w-xl">
          <div class="lp-reveal flex justify-center">
            <span class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-4 py-1.5 text-xs font-bold text-emerald-900 ring-1 ring-emerald-200">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-3.5 w-3.5"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.287 1.288L3 12l5.8 1.9a2 2 0 0 1 1.288 1.287L12 21l1.9-5.8a2 2 0 0 1 1.287-1.288L21 12l-5.8-1.9a2 2 0 0 1-1.288-1.287Z"/></svg>
              LACOSTE · Bracelet Metropole
            </span>
          </div>

          <h1 class="lp-reveal mt-5 text-center text-3xl font-black leading-tight text-gray-900 sm:text-4xl" style="transition-delay:60ms">
            أناقة تكمل إطلالتك
          </h1>

          <p class="lp-reveal mx-auto mt-3 max-w-md text-center leading-relaxed text-gray-600 sm:text-lg" style="transition-delay:120ms">
            حلقات <span class="font-bold text-emerald-800">H</span> ونقشة <span class="font-bold text-emerald-800">petit piqué</span> — لمسة لاكوست راقية تكمل أي إطلالة، من الصباح حتى السهرة.
          </p>

          <figure class="lp-reveal relative mt-7" style="transition-delay:180ms">
            <div class="overflow-hidden rounded-3xl bg-gray-100 shadow-xl shadow-emerald-900/10 ring-1 ring-emerald-900/10">
              {heroImage ? (
                <img
                  src={heroImage}
                  alt={product?.name ?? "Bracelet Metropole"}
                  width="900"
                  height="1125"
                  fetchpriority="high"
                  loading="eager"
                  decoding="async"
                  class="aspect-[4/5] w-full object-cover"
                />
              ) : (
                <div class="flex aspect-[4/5] w-full flex-col items-center justify-center gap-3 bg-gradient-to-br from-emerald-50 via-white to-gray-100">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-14 w-14 text-emerald-800/20"><path d="M9 17H7A5 5 0 0 1 7 7h2"/><path d="M15 7h2a5 5 0 1 1 0 10h-2"/><path d="M8 12h8"/></svg>
                  <p class="text-sm font-bold tracking-[0.35em] text-emerald-900/40">LACOSTE</p>
                  <p class="text-xs text-gray-400">Bracelet Metropole</p>
                </div>
              )}
            </div>

            {isOutOfStock ? (
              <span class="absolute start-4 top-4 rounded-full bg-red-600 px-3 py-1.5 text-xs font-black text-white shadow-lg">نفد المخزون</span>
            ) : discountPct ? (
              <span class="absolute start-4 top-4 rounded-full bg-emerald-700 px-3.5 py-1.5 text-sm font-black text-white shadow-lg shadow-emerald-950/30">-{discountPct}%</span>
            ) : null}
          </figure>

          <div class="lp-reveal mt-7 text-center" style="transition-delay:240ms">
            <div class="flex flex-wrap items-baseline justify-center gap-x-3 gap-y-1">
              <span class="text-4xl font-black tracking-tight text-emerald-900">{priceDisplay}</span>
              <span class="text-lg font-bold text-emerald-700">{cur}</span>
              {comparePriceDisplay && (
                <span class="text-xl font-bold text-gray-400 line-through">{comparePriceDisplay} {cur}</span>
              )}
            </div>
            {hasDiscount && savedDisplay && (
              <p class="mt-2 text-sm font-semibold text-gray-500">وفّر <span class="text-emerald-700">{cur} {savedDisplay}</span> بهاد العرض</p>
            )}
            {product?.trackInventory && typeof product.inventory === "number" && product.inventory > 0 && product.inventory <= 5 && (
              <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-red-50 px-3.5 py-1.5 text-xs font-bold text-red-700 ring-1 ring-red-200">
                <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-red-400 opacity-75"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-red-500"></span></span>
                {product.inventory === 1 ? "باقي براسلي واحد فقط في المخزون" : `باقي ${product.inventory} براسلي فقط في المخزون`}
              </p>
            )}
          </div>

          <a href="#order-section-wrapper" class="lp-cta-pulse mt-6 flex w-full items-center justify-center gap-2.5 rounded-2xl bg-emerald-700 px-6 py-4 text-base font-black text-white shadow-lg shadow-emerald-700/30 transition hover:bg-emerald-800 active:scale-[0.98] sm:text-lg">
            <span>اطلب دابا — الدفع عند الاستلام</span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="lp-flip h-5 w-5 rtl:rotate-180"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>

          <p class="lp-reveal mt-3.5 flex items-center justify-center gap-1.5 text-center text-xs font-medium text-gray-500" style="transition-delay:300ms">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-3.5 w-3.5 text-emerald-700"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
            بدون بطاقة بنكية · التوصيل لـ {WILAYA_COUNT} ولاية
          </p>
        </div>
      </section>

      <!-- شارات الثقة -->
      <section class="border-y border-gray-100 bg-gray-50/80 py-7" aria-label="ضمانات الشراء">
        <div class="mx-auto grid max-w-lg grid-cols-2 gap-3 px-4 sm:max-w-2xl sm:grid-cols-4 sm:gap-4">
          {trustBadges.map((b, i) => (
            <div class="lp-reveal flex flex-col items-center gap-2.5 rounded-2xl bg-white p-4 text-center shadow-sm ring-1 ring-gray-100" style={`transition-delay:${(i % 2) * 70}ms`}>
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-emerald-700/10 text-emerald-800 ring-1 ring-emerald-700/10">
                {b.icon === "banknote" && (<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-5 w-5"><rect width="20" height="12" x="2" y="6" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01"/><path d="M18 12h.01"/></svg>)}
                {b.icon === "truck" && (<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-5 w-5"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>)}
                {b.icon === "badge" && (<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-5 w-5"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>)}
                {b.icon === "headset" && (<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-5 w-5"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5Z"/><path d="M21 14h-3a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-5Z"/><path d="M3 14v-3a9 9 0 0 1 18 0v3"/></svg>)}
              </span>
              <div>
                <p class="text-sm font-bold text-gray-900">{b.title}</p>
                <p class="mt-0.5 text-xs leading-snug text-gray-500">{b.text}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- بطاقات المميزات -->
