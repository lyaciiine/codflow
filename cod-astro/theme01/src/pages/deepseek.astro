---
import StoreLayout from "@/theme/layouts/StoreLayout.astro";
import OrderForm from "@/theme/components/order/OrderForm.astro";
import ShippingIsland from "@/theme/components/product/ShippingIsland.astro";
import { getStoreContext } from "@/theme/config/store";
import { fetchLandingPageBySlug } from "@/core/api/client";
import { actions } from "astro:actions";
import { isInputError } from "astro:actions";

const storeCtx = await getStoreContext();
const { config, content, isRTL } = storeCtx;

// استدعاء صفحة الهبوط بالـ Slug الصحيح
const lp = await fetchLandingPageBySlug("lacoste");
const product = lp?.product;

const cur = config.currencySymbol;
const defaultVariant = product?.hasVariants
  ? (product.variants.find((v: any) => v.isDefault) ?? product.variants[0])
  : null;
const basePrice = defaultVariant?.price ?? product?.price ?? 0;
const comparePrice = defaultVariant?.compareAtPrice ?? product?.compareAtPrice ?? null;
const isOutOfStock = product?.trackInventory && product.inventory === 0;
const defaultVariantId = defaultVariant?.id ?? null;

// معالجة إرسال الطلبية
const result = Astro.getActionResult(actions.placeOrder);
if (result?.data?.orderNumber) {
  return Astro.redirect(
    `/thank-you?order=${encodeURIComponent(result.data.orderNumber)}&total=${result.data.total}&oid=${encodeURIComponent(result.data.orderId ?? "")}`,
    303,
  );
}
const fieldErrors = isInputError(result?.error) ? result.error.fields : {};
const serverError = result?.error && !isInputError(result.error) ? result.error.message : null;

// ===== DESIGN-ONLY additions (after the locked lines) =====

// استخراج الصور من كل المصادر الممكنة، ونقبلو string أو object
const pickImg = (x: any): string | null => {
  if (!x) return null;
  if (typeof x === "string") return x.trim() || null;
  if (typeof x === "object") {
    const v = x.url ?? x.src ?? x.image ?? x.imageUrl ?? x.original ?? null;
    return typeof v === "string" && v.trim() ? v.trim() : null;
  }
  return null;
};
const asList = (x: any): any[] => (Array.isArray(x) ? x : x ? [x] : []);

const gallery: string[] = [
  ...new Set(
    [
      ...asList((product as any)?.images),
      ...asList((lp as any)?.images),
      (product as any)?.image,
      (product as any)?.thumbnail,
      (lp as any)?.image,
    ]
      .map(pickImg)
      .filter(Boolean) as string[],
  ),
];

const heroImg = gallery[0] ?? null;
const galleryRest = gallery.slice(1, 8);

const discountPct =
  comparePrice && comparePrice > basePrice
    ? Math.round(((comparePrice - basePrice) / comparePrice) * 100)
    : null;

const nf = new Intl.NumberFormat("en-US");
const fmt = (n: number) => nf.format(Math.round(n));
const productName = (product as any)?.name ?? "براسليه Lacoste Metropole";
---

<StoreLayout config={config} content={content} title={lp?.metaTitle || "عرض خاص"} marketing={true}>
  {product && (
    <div
      class="w-full max-w-full overflow-x-hidden min-h-screen bg-[var(--c-bg)] text-[var(--c-ink)] pb-28 lg:pb-20"
      dir={isRTL ? "rtl" : "ltr"}
      style="--c-bg:#F5F4F1;--c-surface:#FFFFFF;--c-ink:#14181A;--c-muted:#5C6469;--c-primary:#0B5D3B;--c-soft:#E8EFEA;--c-cta:#0B5D3B;--c-gold:#B8894A;--c-line:rgba(20,24,26,.10);"
    >
      
      <!-- جسر البيانات اللازم للسكريبتات والولايات -->
      <div
        id="page-data"
        class="sr-only"
        data-variants={JSON.stringify(product.variants ?? [])}
        data-base-price={basePrice}
        data-compare-price={comparePrice ?? ""}
        data-cur={cur}
        data-is-rtl={isRTL ? "1" : "0"}
        data-shipping-label={content.shippingLabel}
        data-shipping-calc={content.shippingCalculated}
        data-shipping-free={content.shippingFree}
        data-total-label={content.totalLabel}
        data-commune-placeholder={content.formCommunePlaceholder}
        data-commune-loading={content.formCommuneLoading}
        data-commune-disabled={content.formCommuneDisabled}
        data-offers={JSON.stringify(product.offers ?? [])}
        data-track-inventory={product.trackInventory ? "1" : "0"}
        data-out-of-stock-label={content.outOfStock}
        data-qty-max-stock={content.qtyMaxStock}
        data-inventory={String(product.inventory ?? 0)}
        data-pixel-id={lp.tracking?.pixelId ?? config.pixelId ?? ""}
        data-phone-invalid={content.formPhoneInvalid}
        data-product-id={product.id}
        data-product-name={product.name}
      />

      <ShippingIsland server:defer />

      <!-- DESIGN START: HERO -->
      <section class="mx-auto w-full max-w-6xl px-4 sm:px-6 pt-6 sm:pt-10 pb-10 sm:pb-14">
        <div class="grid w-full min-w-0 gap-8 lg:gap-14 lg:grid-cols-2 lg:items-center">

          <!-- الصورة -->
          <div class="w-full min-w-0 dz-rise">
            <div class="relative w-full overflow-hidden rounded-[28px] bg-[var(--c-surface)] border border-[var(--c-line)]">
              <div class="aspect-square w-full">
                {heroImg ? (
                  <img
                    src={heroImg}
                    alt={`براسليه ${productName} — صورة المنتج`}
                    width="900"
                    height="900"
                    fetchpriority="high"
                    decoding="async"
                    class="block h-full w-full max-w-full object-cover"
                  />
                ) : (
                  <div class="grid h-full w-full place-items-center bg-[#EDEBE6] px-6 text-center text-sm text-[var(--c-muted)]">
                    <span>REPLACE — حط هنا تصويرة المنتج (4:5 / 1:1)</span>
                  </div>
                )}
              </div>

              {discountPct && (
                <span class="absolute top-4 end-4 rounded-full bg-[var(--c-primary)] px-3 py-1.5 text-[12px] font-extrabold text-white">
                  -{discountPct}%
                </span>
              )}
            </div>

            {galleryRest.length > 0 && (
              <div class="mt-3 w-full max-w-full flex snap-x snap-mandatory gap-2 overflow-x-auto pb-1">
                {galleryRest.map((src, i) => (
                  <img
                    src={src}
                    alt={`${productName} — صورة ${i + 2}`}
                    width="200"
                    height="200"
                    loading="lazy"
                    decoding="async"
                    class="block h-20 w-20 max-w-full shrink-0 snap-center rounded-2xl border border-[var(--c-line)] object-cover"
                  />
                ))}
              </div>
            )}
          </div>

          <!-- المحتوى -->
          <div class="w-full min-w-0 dz-rise dz-rise-2">
            <p class="inline-flex items-center gap-2 rounded-full bg-[var(--c-soft)] px-3.5 py-1.5 text-[13px] font-extrabold text-[var(--c-primary)]">
              <span class="h-1.5 w-1.5 rounded-full bg-[var(--c-primary)]"></span>
              <bdi>Lacoste</bdi> · <bdi>Metropole</bdi>
            </p>

            <div class="mt-4 h-px w-14 bg-[var(--c-gold)]"></div>

            <h1 class="mt-4 text-[28px] font-black leading-[1.35] sm:text-4xl lg:text-[46px]">
              براسليه <bdi>Lacoste</bdi> بستايل كلاسيكي، يتلبس كل يوم
            </h1>

            <p class="mt-4 max-w-[60ch] text-[16px] leading-loose text-[var(--c-muted)] sm:text-[17px]">
              معدن <bdi>hypoallergénique</bdi>، تصميم <bdi>Metropole</bdi> بحلقات <bdi>H</bdi> والوسط
              <bdi>petit piqué</bdi>. قطر داخلي 19 سم، وإذا طويل عليك تقدر تقصّرو عند الصايغي.
            </p>

            <!-- السوم -->
            <div class="mt-6 flex flex-wrap items-end gap-3">
              <span class="text-[28px] font-black leading-none sm:text-4xl">
                {fmt(basePrice)}<span class="ms-1 text-base font-extrabold">{cur}</span>
              </span>
              {comparePrice && comparePrice > basePrice && (
                <span class="text-base font-medium leading-none text-[var(--c-muted)] line-through">
                  {fmt(comparePrice)} {cur}
                </span>
              )}
            </div>

            <!-- CTA -->
            <a
              href="#order-section-wrapper"
              class="mt-6 flex min-h-[56px] w-full items-center justify-center rounded-2xl bg-[var(--c-cta)] px-6 text-[17px] font-extrabold text-white shadow-lg transition active:scale-[.99] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--c-ink)] motion-safe:hover:brightness-110"
            >
              اطلب الآن — الدفع عند الاستلام
            </a>

            <!-- Trust chips -->
            <ul class="mt-5 grid w-full grid-cols-1 gap-2 text-[13px] font-bold sm:grid-cols-3 sm:text-[14px]">
              <li class="flex min-w-0 items-center gap-2 rounded-xl bg-[var(--c-surface)] px-3 py-2 border border-[var(--c-line)]">
                <svg class="h-4 w-4 shrink-0 text-[var(--c-primary)]" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M8.1 14.2 4.3 10.4l1.4-1.4 2.4 2.4 6-6 1.4 1.4z"/></svg>
                <span class="min-w-0">الدفع عند الاستلام</span>
              </li>
              <li class="flex min-w-0 items-center gap-2 rounded-xl bg-[var(--c-surface)] px-3 py-2 border border-[var(--c-line)]">
                <svg class="h-4 w-4 shrink-0 text-[var(--c-primary)]" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M8.1 14.2 4.3 10.4l1.4-1.4 2.4 2.4 6-6 1.4 1.4z"/></svg>
                <span class="min-w-0">التوصيل لجميع الولايات</span>
              </li>
              <li class="flex min-w-0 items-center gap-2 rounded-xl bg-[var(--c-surface)] px-3 py-2 border border-[var(--c-line)]">
                <svg class="h-4 w-4 shrink-0 text-[var(--c-primary)]" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M8.1 14.2 4.3 10.4l1.4-1.4 2.4 2.4 6-6 1.4 1.4z"/></svg>
                <span class="min-w-0">تفحّص المنتج قبل الدفع</span>
              </li>
            </ul>
          </div>
        </div>
      </section>
      <!-- DESIGN END: HERO -->

      <!-- DESIGN START: PROOF STRIP -->
      <section class="w-full border-y border-[var(--c-line)] bg-[var(--c-surface)]">
        <div class="mx-auto grid w-full max-w-6xl gap-6 px-4 py-8 sm:grid-cols-3 sm:px-6 sm:py-10">
          <div class="min-w-0 text-center sm:text-start">
            <div class="text-[13px] font-extrabold text-[var(--c-gold)]">المقاس</div>
            <div class="mt-1 text-[15px] font-bold">19 سم قطر داخلي</div>
            <p class="mt-1 text-[13px] leading-relaxed text-[var(--c-muted)]">قابل للتقصير في أي محل ساعات / مجوهرات</p>
          </div>
          <div class="min-w-0 text-center sm:text-start">
            <div class="text-[13px] font-extrabold text-[var(--c-gold)]">الإغلاق</div>
            <div class="mt-1 text-[15px] font-bold"><bdi>Fermoir déployant</bdi></div>
            <p class="mt-1 text-[13px] leading-relaxed text-[var(--c-muted)]">إغلاق آمن، ما يطيحش من يدك</p>
          </div>
          <div class="min-w-0 text-center sm:text-start">
            <div class="text-[13px] font-extrabold text-[var(--c-gold)]">المعدن</div>
            <div class="mt-1 text-[15px] font-bold"><bdi>Hypoallergénique</bdi></div>
            <p class="mt-1 text-[13px] leading-relaxed text-[var(--c-muted)]">ما يهيّجش الجلد، مناسب للاستعمال اليومي</p>
          </div>
        </div>
      </section>
      <!-- DESIGN END: PROOF STRIP -->

      <!-- DESIGN START: PROBLEM → SOLUTION -->
      <section class="mx-auto w-full max-w-3xl px-4 py-12 text-center sm:px-6 sm:py-16">
        <h2 class="text-[22px] font-black leading-snug sm:text-[30px]">
          تحوّس على تفصيلة تكمّل الّلوك؟
        </h2>
        <p class="mt-4 text-[16px] leading-loose text-[var(--c-muted)]">
          براسليه صغير، بسيط، ومرتّب — يدير الفرق في أي outfit، سواء لبست كلاسيك ولا سبور.
          تصميم <bdi>Metropole</bdi> بحلقات <bdi>H</bdi> ووسط <bdi>petit piqué</bdi> يعطيه ذاك الستايل
          اللي يميّزو <bdi>Lacoste</bdi>، بلا ما يكون ثقيل ولا مزوق بزاف.
        </p>
      </section>
      <!-- DESIGN END: PROBLEM → SOLUTION -->

      <!-- DESIGN START: BENEFITS -->
      <section class="mx-auto w-full max-w-6xl px-4 pb-12 sm:px-6 sm:pb-16">
        <div class="grid w-full gap-4 sm:grid-cols-2">
          {[
            {
              t: "تصميم Metropole الأصلي",
              d: "حلقات H والوسط بنقشة petit piqué — الموتيف المعروف تاع Lacoste، بتفاصيل نظيفة.",
            },
            {
              t: "معدن hypoallergénique",
              d: "ما يهيّجش الجلد وما يخلّيش أثر، تقدر تلبسو نهار كامل بلا مشكل.",
            },
            {
              t: "Fermoir déployant",
              d: "إغلاق بالطيّ، ثابت وما يتحلّش وحدو. تلبسو وتنساه.",
            },
            {
              t: "يتبدّل على مقاسك",
              d: "19 سم كيما هو، وإذا طويل عليك أي صايغي يقصّرو ليك بسهولة.",
            },
          ].map((b) => (
            <div class="min-w-0 rounded-2xl border border-[var(--c-line)] bg-[var(--c-surface)] p-5">
              <div class="h-px w-8 bg-[var(--c-gold)]"></div>
              <h3 class="mt-3 text-[17px] font-extrabold leading-snug">{b.t}</h3>
              <p class="mt-2 text-[15px] leading-loose text-[var(--c-muted)]">{b.d}</p>
            </div>
          ))}
        </div>
      </section>
      <!-- DESIGN END: BENEFITS -->

      <!-- DESIGN START: SPECS -->
      <section class="mx-auto w-full max-w-3xl px-4 pb-14 sm:px-6 sm:pb-20">
        <h2 class="text-[22px] font-black sm:text-[26px]">تفاصيل المنتج</h2>
        <div class="mt-5 w-full overflow-hidden rounded-2xl border border-[var(--c-line)] bg-[var(--c-surface)]">
          <dl class="divide-y divide-[var(--c-line)]">
            <div class="flex items-start justify-between gap-4 px-4 py-3.5 sm:px-5">
              <dt class="text-[14px] font-bold text-[var(--c-muted)]">الماركة</dt>
              <dd class="text-[15px] font-extrabold"><bdi>Lacoste</bdi></dd>
            </div>
            <div class="flex items-start justify-between gap-4 px-4 py-3.5 sm:px-5">
              <dt class="text-[14px] font-bold text-[var(--c-muted)]">الموديل</dt>
              <dd class="text-[15px] font-extrabold"><bdi>Metropole</bdi></dd>
            </div>
            <div class="flex items-start justify-between gap-4 px-4 py-3.5 sm:px-5">
              <dt class="text-[14px] font-bold text-[var(--c-muted)]">التصميم</dt>
              <dd class="text-[15px] font-extrabold text-end">حلقات <bdi>H</bdi> + وسط <bdi>petit piqué</bdi></dd>
            </div>
            <div class="flex items-start justify-between gap-4 px-4 py-3.5 sm:px-5">
              <dt class="text-[14px] font-bold text-[var(--c-muted)]">المادة</dt>
              <dd class="text-[15px] font-extrabold text-end">معدن <bdi>hypoallergénique</bdi></dd>
            </div>
            <div class="flex items-start justify-between gap-4 px-4 py-3.5 sm:px-5">
              <dt class="text-[14px] font-bold text-[var(--c-muted)]">القطر الداخلي</dt>
              <dd class="text-[15px] font-extrabold"><bdi>19</bdi> سم</dd>
            </div>
            <div class="flex items-start justify-between gap-4 px-4 py-3.5 sm:px-5">
              <dt class="text-[14px] font-bold text-[var(--c-muted)]">الإغلاق</dt>
              <dd class="text-[15px] font-extrabold"><bdi>Fermoir déployant</bdi></dd>
            </div>
            <div class="flex items-start justify-between gap-4 px-4 py-3.5 sm:px-5">
              <dt class="text-[14px] font-bold text-[var(--c-muted)]">التقصير</dt>
              <dd class="text-[15px] font-extrabold text-end">ممكن عند الصايغي إذا حبيت</dd>
            </div>
          </dl>
        </div>
        <p class="mt-3 text-[13px] leading-relaxed text-[var(--c-muted)]">
          الباكيتاج / المحتوى: <span class="font-bold">REPLACE</span> — أكّد واش يجي معاه (علبة، كارت، ...).
        </p>
      </section>
      <!-- DESIGN END: SPECS -->

      <!-- ═══════════ ORDER BLOCK ═══════════ -->
      <div class="mx-auto w-full max-w-xl scroll-mt-24 px-4 sm:px-6" id="order-section-wrapper">

        <!-- DESIGN START: above the form -->
        <div class="mb-5 text-center">
          <h2 class="text-[22px] font-black leading-snug sm:text-[28px]">
            اطلب الآن، وخلّص كي تستلم
          </h2>
          <p class="mx-auto mt-3 max-w-[46ch] text-[15px] leading-loose text-[var(--c-muted)]">
            عمّر المعلومات، فريقنا يتصل بك لتأكيد الطلب، والدفع عند الاستلام.
          </p>

          <div class="mt-5 flex items-center justify-between gap-4 rounded-2xl border border-[var(--c-line)] bg-[var(--c-surface)] px-4 py-3 text-start">
            <span class="min-w-0 text-[14px] font-bold leading-snug">{productName}</span>
            <span class="shrink-0 text-[15px] font-black">
              {fmt(basePrice)} <span class="text-xs font-extrabold">{cur}</span>
            </span>
          </div>
        </div>
        <!-- DESIGN END: above the form -->

        <div class="w-full rounded-3xl border border-[var(--c-line)] bg-[var(--c-surface)] p-4 sm:p-6">
          <OrderForm
            product={product}
            content={content}
            fieldErrors={fieldErrors}
            serverError={serverError}
            basePrice={basePrice}
            defaultVariant={defaultVariant ?? null}
            cur={cur}
            isRTL={isRTL}
            offers={product.offers}
            defaultVariantId={defaultVariantId}
            isOutOfStock={isOutOfStock}
            otpEnabled={config.otpEnabled === true}
            turnstileEnabled={config.turnstileEnabled === true}
            turnstileSiteKey={config.turnstileSiteKey ?? null}
            pages={config.pages ?? []}
            formPolicy={config.checkoutForm}
            landingPageSlug={lp.slug}
          />
        </div>

        <!-- DESIGN START: below the form -->
        <ul class="mt-4 grid w-full grid-cols-1 gap-2 text-[13px] font-bold sm:grid-cols-3">
          <li class="flex min-w-0 items-center gap-2 rounded-xl bg-[var(--c-soft)] px-3 py-2.5 text-[var(--c-primary)]">
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M8.1 14.2 4.3 10.4l1.4-1.4 2.4 2.4 6-6 1.4 1.4z"/></svg>
            <span class="min-w-0">بلا خلاص مقدّم</span>
          </li>
          <li class="flex min-w-0 items-center gap-2 rounded-xl bg-[var(--c-soft)] px-3 py-2.5 text-[var(--c-primary)]">
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M8.1 14.2 4.3 10.4l1.4-1.4 2.4 2.4 6-6 1.4 1.4z"/></svg>
            <span class="min-w-0">تأكيد بالتيليفون</span>
          </li>
          <li class="flex min-w-0 items-center gap-2 rounded-xl bg-[var(--c-soft)] px-3 py-2.5 text-[var(--c-primary)]">
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M8.1 14.2 4.3 10.4l1.4-1.4 2.4 2.4 6-6 1.4 1.4z"/></svg>
            <span class="min-w-0">تفحّص قبل الدفع</span>
          </li>
        </ul>

        <p class="mt-4 text-center text-[13px] leading-loose text-[var(--c-muted)]">
          واش يصرا من بعد؟ نعيّطو ليك نأكدو الطلبية ← نبعثوها مع الليفرور ← تستلم وتخلّص.
        </p>
        <!-- DESIGN END: below the form -->
      </div>
      <!-- ═══════════ /ORDER BLOCK ═══════════ -->

      <!-- DESIGN START: GUARANTEE & DELIVERY -->
      <section class="mx-auto w-full max-w-6xl px-4 pt-14 sm:px-6 sm:pt-20">
        <div class="grid w-full gap-4 sm:grid-cols-3">
          <div class="min-w-0 rounded-2xl bg-[var(--c-surface)] p-5 border border-[var(--c-line)]">
            <div class="text-[13px] font-extrabold text-[var(--c-gold)]">الدفع</div>
            <h3 class="mt-2 text-[16px] font-extrabold">الدفع عند الاستلام</h3>
            <p class="mt-2 text-[14px] leading-loose text-[var(--c-muted)]">
              ما تخلّصش حتى توصلك الطلبية وتشوفها بعينك.
            </p>
          </div>
          <div class="min-w-0 rounded-2xl bg-[var(--c-surface)] p-5 border border-[var(--c-line)]">
            <div class="text-[13px] font-extrabold text-[var(--c-gold)]">التفحّص</div>
            <h3 class="mt-2 text-[16px] font-extrabold">شوف المنتج قبل ما تخلّص</h3>
            <p class="mt-2 text-[14px] leading-loose text-[var(--c-muted)]">
              حقّك تفتح الطلبية وتتأكد من البراسليه قبل الدفع.
            </p>
          </div>
          <div class="min-w-0 rounded-2xl bg-[var(--c-surface)] p-5 border border-[var(--c-line)]">
            <div class="text-[13px] font-extrabold text-[var(--c-gold)]">التوصيل</div>
            <h3 class="mt-2 text-[16px] font-extrabold">لجميع الولايات</h3>
            <p class="mt-2 text-[14px] leading-loose text-[var(--c-muted)]">
              مدة التوصيل: <span class="font-bold">REPLACE</span> · سياسة الاستبدال: <span class="font-bold">REPLACE</span>.
            </p>
          </div>
        </div>
      </section>
      <!-- DESIGN END: GUARANTEE & DELIVERY -->

      <!-- DESIGN START: FINAL CTA -->
      <section class="mx-auto w-full max-w-3xl px-4 pb-16 pt-14 sm:px-6 sm:pb-24 sm:pt-20">
        <div class="w-full rounded-3xl border border-[var(--c-line)] bg-[var(--c-surface)] px-5 py-9 text-center sm:px-10 sm:py-12">
          <div class="mx-auto h-px w-12 bg-[var(--c-gold)]"></div>
          <h2 class="mt-5 text-[22px] font-black leading-snug sm:text-[28px]">
            براسليه <bdi>Lacoste</bdi> بستايل كلاسيكي، يتلبس كل يوم
          </h2>
          <p class="mt-4 text-[28px] font-black leading-none sm:text-4xl">
            {fmt(basePrice)}<span class="ms-1 text-base font-extrabold">{cur}</span>
          </p>
          {comparePrice && comparePrice > basePrice && (
            <p class="mt-2 text-[15px] text-[var(--c-muted)] line-through">
              {fmt(comparePrice)} {cur}
            </p>
          )}
          <a
            href="#order-section-wrapper"
            class="mx-auto mt-6 flex min-h-[56px] w-full max-w-md items-center justify-center rounded-2xl bg-[var(--c-cta)] px-6 text-[17px] font-extrabold text-white shadow-lg transition active:scale-[.99] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--c-ink)] motion-safe:hover:brightness-110"
          >
            اطلب الآن — الدفع عند الاستلام
          </a>
          <p class="mt-4 text-[13px] leading-loose text-[var(--c-muted)]">
            الدفع عند الاستلام · تتصل بك خدمة العملاء لتأكيد الطلب.
          </p>
        </div>
      </section>
      <!-- DESIGN END: FINAL CTA -->

      <!-- DESIGN START: STICKY CTA BAR -->
      <div
        id="sticky-cta"
        class="fixed inset-x-0 bottom-0 z-40 transition-transform duration-300 ease-out lg:hidden"
        style="padding-bottom: env(safe-area-inset-bottom);"
      >
        <div class="mx-3 mb-3 flex items-center gap-3 rounded-2xl border border-[var(--c-line)] bg-white/95 px-3 py-2.5 shadow-[0_-2px_24px_rgba(20,24,26,.12)] backdrop-blur">
          <div class="min-w-0 shrink-0">
            <div class="text-[15px] font-black leading-tight">
              {fmt(basePrice)} <span class="text-[11px] font-extrabold">{cur}</span>
            </div>
            {comparePrice && comparePrice > basePrice && (
              <div class="text-[11px] leading-tight text-[var(--c-muted)] line-through">
                {fmt(comparePrice)} {cur}
              </div>
            )}
          </div>
          <a
            href="#order-section-wrapper"
            class="flex min-h-[48px] flex-1 items-center justify-center rounded-xl bg-[var(--c-cta)] px-4 text-[15px] font-extrabold text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--c-ink)]"
          >
            اطلب الآن
          </a>
        </div>
      </div>
      <!-- DESIGN END: STICKY CTA BAR -->

    </div>
  )}

  {!product && (
    <div class="flex flex-col items-center justify-center py-24 px-6 text-center">
      <h1 class="text-2xl font-black text-red-600">عذراً، لم يتم العثور على صفحة الهبوط أو أن الslug خاطئ.</h1>
    </div>
  )}
</StoreLayout>

