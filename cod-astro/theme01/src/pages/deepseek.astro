<!-- DESIGN START: CTA scroll + sticky bar -->
<script>
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const target = document.querySelector("#order-section-wrapper");

  document
    .querySelectorAll('a[href="#order-section-wrapper"]')
    .forEach((a) =>
      a.addEventListener("click", (e) => {
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "start" });
      }),
    );

  const bar = document.querySelector("#sticky-cta");
  if (bar && target) {
    new IntersectionObserver(
      ([entry]) => {
        bar.classList.toggle("translate-y-[130%]", entry.isIntersecting);
      },
      { rootMargin: "0px 0px -20% 0px" },
    ).observe(target);
  }
</script>
<!-- DESIGN END: CTA scroll + sticky bar -->

<!-- DESIGN START: hero reveal -->
<style>
  @keyframes dz-rise {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: none; }
  }
  .dz-rise {
    animation: dz-rise 0.7s cubic-bezier(0.22, 0.9, 0.28, 1) both;
  }
  .dz-rise-2 {
    animation-delay: 0.09s;
  }
  @media (prefers-reduced-motion: reduce) {
    .dz-rise,
    .dz-rise-2 {
      animation: none;
    }
  }
</style>
<!-- DESIGN END: hero reveal -->

